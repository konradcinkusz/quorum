@page "/"

<PageTitle>Home</PageTitle>

<AuthorizeView Policy="AdminRoles">
    <Authorized>
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <ul class="nav justify-content-center">
                        <li class="nav-item">
                            <NavLink href="" Match="NavLinkMatch.All" class="nav-link">
                                <div class="nav-link-container">
                                    <span class="oi oi-home mr-2"></span>
                                    Home
                                </div>
                            </NavLink>
                        </li>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="subscription">
                                <span class="oi oi-cart"></span> Sub &amp; payments
                            </NavLink>
                        </li>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="create-payment">
                                <span class="oi oi-plus"></span> Add payment
                            </NavLink>
                        </li>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="payments">
                                <span class="oi oi-dollar"></span> Payments
                            </NavLink>
                        </li>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="/admin/dashboard">
                                <span class="oi oi-cog"></span> Admin dashboard
                            </NavLink>
                        </li>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="/admin/quarter">
                                <span class="oi oi-calendar"></span> Create quarter
                            </NavLink>
                        </li>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="/admin/quarters">
                                <span class="oi oi-bar-chart"></span> Quarters
                            </NavLink>
                        </li>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="/admin/SignaturePools">
                                <span class="oi oi-pencil"></span> Signature pools
                            </NavLink>
                        </li>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="/admin/issue">
                                <span class="oi oi-badge"></span> Create issue
                            </NavLink>
                        </li>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="/admin/Issues">
                                <span class="oi oi-document"></span> Issues
                            </NavLink>
                        </li>
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" href="onepager">
                                <span class="oi oi-lightbulb" aria-hidden="true"></span> One pager
                            </NavLink>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        @if (user is not null)
        {
            <h3>@user.Identity.Name</h3>
            <div class="m-2 p-2">
                Is Authenticated: @user.Identity.IsAuthenticated
            </div>
            <div class="m-2 p-2">
                Authentication Type: @user.Identity.AuthenticationType
            </div>
            <div class="m-2 p-2">
                Admin Role: @user.IsInRole("Admin")
            </div>
            <div class="m-2 p-2">
                <h5>Claims</h5>
                @foreach (var claim in user.Claims)
                {
                    <span>
                        @claim.Type
                    </span>
                    <span>:</span>
                    <span>
                        @claim.Value
                    </span>
                    <br />
                }
            </div>
        }
        else
        {
            <div class="m-2 p-2">
                No User Exists
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter] public Task<AuthenticationState> AuthTask { get; set; }

    private System.Security.Claims.ClaimsPrincipal user;

    protected async override Task OnInitializedAsync()
    {
        var authState = await AuthTask;
        this.user = authState.User;
    }
}