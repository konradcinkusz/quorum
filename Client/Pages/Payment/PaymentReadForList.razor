@using System.Globalization
@using System.Linq

@if (Payment != null)
{
    <div class="card m-1 p-1">
        <div class="card-header">
            <h4 class="card-title">Payment Details</h4>
            <a href="/edit-payment/@Payment.Id" class="btn btn-secondary btn-sm">Edit</a>

        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-sm-4">
                    <label for="payment-id" class="form-label">Payment ID:</label>
                    <p class="form-control-plaintext" id="payment-id">@Payment.Id</p>
                </div>
                <div class="col-sm-4">
                    <label for="user-email" class="form-label">User Email:</label>
                    <p class="form-control-plaintext" id="user-email">@Payment.UserEmail</p>
                </div>
                <div class="col-sm-4">
                    <label for="payment-value" class="form-label">Payment Value:</label>
                    <p class="form-control-plaintext" id="payment-value">@Payment.PaymentValuePLN.ToString("C", CultureInfo.GetCultureInfo("pl-PL"))</p>
                </div>
            </div>
            <hr />
            <button class="btn btn-primary mb-3" type="button" @onclick="ToggleDetails">@ShowDetailsButtonText</button>
            <div class="@DetailsCssClass">
                <hr />
                <h5>Payment Details</h5>
                <dl class="row mb-3">
                    <dt class="col-sm-3">Payment Link:</dt>
                    <dd class="col-sm-9"><a href="@Payment.PaymentLink">@Payment.PaymentLink</a></dd>

                    <dt class="col-sm-3">Reference ID:</dt>
                    <dd class="col-sm-9">@Payment.ClientReferenceId</dd>

                    <dt class="col-sm-3">Payment Intent ID:</dt>
                    <dd class="col-sm-9">@Payment.PaymentIntentId</dd>

                    <dt class="col-sm-3">Session ID:</dt>
                    <dd class="col-sm-9">@Payment.SessionId</dd>

                    <dt class="col-sm-3">Created At:</dt>
                    <dd class="col-sm-9">@Payment.CreatedAt.ToString("g", CultureInfo.InvariantCulture)</dd>

                    <dt class="col-sm-3">More:</dt>
                    <dd class="col-sm-9"><a href="/payments/@Payment.Id">View Payment Details</a></dd>

                    <dt class="col-sm-3">Payment Status History:</dt>
                    <dd class="col-sm-9">
                        @if (Payment.PaymentStatusHistory != null && Payment.PaymentStatusHistory.Any())
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Payment Status</th>
                                        <th>Status Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var history in Payment.PaymentStatusHistory)
                                    {
                                        <tr>
                                            <td>@history.PaymentStatus</td>
                                            <td>@history.StatusDate.ToString("g", CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p>No payment status history available.</p>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
}
else
{
    <p>No payment to display.</p>
}

@code {
    [Parameter]
    public PaymentDTO Payment { get; set; }

    [Parameter]
    public string ShowDetailsButtonText { get; set; } = "Show Details";

    [Parameter]
    public string GetDetailsButtonText { get; set; } = "Get Details";

    private string DetailsCssClass => showDetails ? "d-block" : "d-none";

    private bool showDetails = false;

    private void ToggleDetails()
    {
        showDetails = !showDetails;

        if (showDetails)
        {
            GetDetailsButtonText = "Hide Details";
            ShowDetailsButtonText = GetDetailsButtonText;
        }
        else
        {
            GetDetailsButtonText = "Get Details";
            ShowDetailsButtonText = GetDetailsButtonText;
        }
    }

}
