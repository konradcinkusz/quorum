@inherits BasePayment
@page "/payments"
@inject IPaymentService paymentService

<PageTitle>Payments list</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (PaymentPagedListDto == null)
        {
            <_Loading LoadingText="Ładowanie listy płatności" />
        }
        else
        {
            <PaymentBrowser Refresh="_refresh"
                        QuerySearch="PaymentQuerySearchDTO"></PaymentBrowser>
            @if (PaymentPagedListDto.Items.Count == 0)
            {
                <p><em>Brak kwestii spełniających kryteria wyszukiwania...</em></p>
            }
            else
            {
                <br />
                <br />
                <_Paging QueryBase="PaymentQuerySearchDTO"
                 RefreshList="_refresh"
                 TotalPages="PaymentPagedListDto.TotalPages"
                 TotalItems="PaymentPagedListDto.TotalItems"></_Paging>

                <div class="content">
                    <div class="container">
                        <div class="row align-content-center justify-content-center">
                            @foreach (var p in PaymentPagedListDto.Items)
                            {
                                <PaymentReadForList Payment="p"></PaymentReadForList>
                            }
                        </div>
                    </div>
                </div>

                <_Paging QueryBase="PaymentQuerySearchDTO"
                 RefreshList="_refresh"
                 TotalPages="PaymentPagedListDto.TotalPages"
                 TotalItems="PaymentPagedListDto.TotalItems"></_Paging>
            }
        }
    </Authorized>
    <NotAuthorized>
        <div class="m-2 p-2 font-weight-bold" style="background-color:grey">
            You must be logged as a super admin user at least to see these page
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    PaymentSearchParamsDTO PaymentQuerySearchDTO;
    PaymentPagedListDTO? PaymentPagedListDto;

    protected override async Task OnInitializedAsync()
    {
        PaymentQuerySearchDTO = new PaymentSearchParamsDTO();
        await _refresh();
    }

    async Task _refresh()
    {
        PaymentPagedListDto = await paymentService.GetPayments(PaymentQuerySearchDTO);
        PaymentQuerySearchDTO.CurrentPage = PaymentPagedListDto.CurrentPage;
        PaymentQuerySearchDTO.PageSize = PaymentPagedListDto.PageSize;
    }
}
