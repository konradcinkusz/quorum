@inherits BasePayment
@page "/payments"
@inject IPaymentService paymentService

<PageTitle>Payments list</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (PaymentPagedListDto == null)
        {
            <_Loading LoadingText="Ładowanie listy płatności" />
        }
        else
        {
            <BrowserPayment Refresh="_refresh"
                        SearchParams="PaymentSearchParamsDTO"
                        TotalItems="PaymentPagedListDto.TotalItems"
                        TotalPages="PaymentPagedListDto.TotalPages" />
            @if (PaymentPagedListDto.Items.Count == 0)
            {
                <p><em>Brak kwestii spełniających kryteria wyszukiwania...</em></p>
            }
            else
            {
                <br />
                <br />
                <HeaderPayment Refresh="_refresh"
                                  QuerySearch="PaymentSearchParamsDTO"></HeaderPayment>
                <div class="content">
                    <div class="container">
                        <div class="row align-content-center justify-content-center">
                            @foreach (var p in PaymentPagedListDto.Items)
                            {
                                <ReadPayment Payment="p"></ReadPayment>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <div class="m-2 p-2 font-weight-bold" style="background-color:grey">
            You must be logged as a super admin user at least to see these page
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    PaymentSearchParamsDTO PaymentSearchParamsDTO;
    PaymentPagedListDTO? PaymentPagedListDto;

    protected override async Task OnInitializedAsync()
    {
        PaymentSearchParamsDTO = new PaymentSearchParamsDTO();
        await _refresh();
    }

    async Task _refresh()
    {
        PaymentPagedListDto = await paymentService.GetPayments(PaymentSearchParamsDTO);
        PaymentSearchParamsDTO.CurrentPage = PaymentPagedListDto.CurrentPage;
        PaymentSearchParamsDTO.PageSize = PaymentPagedListDto.PageSize;
    }
}
