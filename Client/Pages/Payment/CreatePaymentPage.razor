@inherits BasePayment
@page "/create-payment"
@using MR.Client.Services
@inject IPaymentService paymentService

<div class="card shadow rounded-3">
    <div class="card-header bg-primary text-white py-3 rounded-3">
        <h5 class="card-title mb-0">Create Payment</h5>
    </div>

    <div class="card-body">
        <EditForm Model="@paymentDto" OnValidSubmit="@CreatePayment">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label for="client-reference-id" class="form-label">ReferenceNumber</label>
                    <InputText id="client-reference-id" class="form-control rounded-pill" @bind-Value="@paymentDto.ReferenceNumber" required />
                    <ValidationMessage For="@(() => paymentDto.ReferenceNumber)" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="payment-link" class="form-label">Payment Method</label>
                    <InputText id="payment-link" class="form-control rounded-pill" @bind-Value="@paymentDto.PaymentMethod" required />
                    <ValidationMessage For="@(() => paymentDto.PaymentMethod)" />
                </div>

                <div class="col-md-12 mb-4">
                    <label for="payment-value-pln" class="form-label">Payment Value (PLN)</label>
                    <InputNumber id="payment-value-pln" class="form-control rounded-pill" @bind-Value="@paymentDto.PaymentValuePLN" required />
                    <ValidationMessage For="@(() => paymentDto.PaymentValuePLN)" />
                </div>

                <div class="col-md-12 d-grid">
                    <button type="submit" class="btn btn-primary rounded-pill">Create Payment</button>
                </div>
            </div>
        </EditForm>
    </div>
</div>
@if (paymentCreated)
{
    <div class="alert alert-success" role="alert">
        Payment created successfully.
    </div>
}

@code {
    private PaymentCreateDTO paymentDto = new PaymentCreateDTO();
    private bool paymentCreated = false;
    private async Task CreatePayment()
    {
        string result = await paymentService.CreatePayment(paymentDto);
        paymentCreated = !string.IsNullOrWhiteSpace(result);
    }
}
