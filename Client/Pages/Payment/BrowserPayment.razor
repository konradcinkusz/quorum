@inherits BasePayment

<div class="row domain-search bg-green rounded row-spacing">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="row g-3 mt-2">
                    <div class="col-md-9 col-sm-12">
                        <label for="userEmail" class="text-white">User email</label>
                        <input type="search" id="userEmail" class="form-control rounded-pill" placeholder="Enter user email..." @bind-value="SearchParams.ApplicationUserEmail" @bind-value:event="oninput">
                    </div>
                    <div class="col-md-3 col-sm-12 text-end">
                        <button type="submit" class="btn btn-outline-light btn-block rounded-pill" @onclick="ClearQuery"><span class="flex-center search">Clear</span></button>
                        <button type="submit" class="btn btn-outline-light btn-block rounded-pill" @onclick="async () => await Refresh.InvokeAsync()"><span class="flex-center search">Search</span></button>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-9 col-sm-9">
                        <label for="paymentId" class="text-white">Payment Id (full or just a part)</label>
                        <input type="search" id="paymentId" class="form-control rounded-pill" placeholder="Enter part of payment ID" @bind-value="SearchParams.PaymentId" @bind-value:event="oninput">
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-3 col-sm-12">
                        <label for="minValue" class="text-white">Minimum value</label>
                        <input type="number" id="minValue" class="form-control rounded-pill" placeholder="Enter minimum value..." @bind-value="SearchParams.MinPaymentValuePLN" @bind-value:event="oninput">
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <label for="maxValue" class="text-white">Maximum value</label>
                        <input type="number" id="maxValue" class="form-control rounded-pill" placeholder="Enter maximum value..." @bind-value="SearchParams.MaxPaymentValuePLN" @bind-value:event="oninput">
                    </div>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <_Paging QueryBase="SearchParams"
                     RefreshList="async () => await Refresh.InvokeAsync()"
                     TotalPages="TotalPages"
                     TotalItems="TotalItems"></_Paging>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public PaymentSearchParamsDTO SearchParams { get; set; }
    [Parameter]
    public EventCallback Refresh { get; set; }
    [Parameter]
    public int TotalPages { get; set; }
    [Parameter]
    public int TotalItems { get; set; } = 0;

    async Task ClearQuery()
    {
        SearchParams.MinPaymentValuePLN = null;
        SearchParams.MaxPaymentValuePLN = null;
        SearchParams.ApplicationUserEmail = null;
        await Refresh.InvokeAsync();
    }
}
