@inherits BasePayment
@page "/edit-payment/{id}"
@inject IPaymentService paymentService
@inject NavigationManager navigationManager

@if (paymentDto != null)
{
    <div class="card shadow rounded-3">
        <div class="card-header bg-primary text-white py-3 rounded-3">
            <h5 class="card-title mb-0">Edit Payment</h5>
        </div>

        <div class="card-body">
            <EditForm Model="@paymentDto" OnValidSubmit="@UpdatePayment">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label for="client-reference-id" class="form-label">Reference number</label>
                        <InputText id="client-reference-id" class="form-control rounded-pill" @bind-Value="@paymentDto.ReferenceNumber" required />
                        <ValidationMessage For="@(() => paymentDto.ReferenceNumber)" />
                    </div>
                    <div class="col-md-6 mb-4">
                        <label for="payment-status" class="form-label">Payment Status</label>
                        <InputSelect id="payment-status" class="form-control rounded-pill" @bind-Value="@paymentDto.PaymentStatus">
                            @foreach (PaymentStatusEnum status in Enum.GetValues(typeof(PaymentStatusEnum)))
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => paymentDto.PaymentStatus)" />
                    </div>
                    <div class="col-md-6 mb-4">
                        <label for="payment-link" class="form-label">PaymentMethod</label>
                        <InputText id="payment-link" class="form-control rounded-pill" @bind-Value="@paymentDto.PaymentMethod" required />
                        <ValidationMessage For="@(() => paymentDto.PaymentMethod)" />
                    </div>

                    <div class="col-md-12 mb-4">
                        <label for="payment-value-pln" class="form-label">Payment Value (PLN)</label>
                        <InputNumber id="payment-value-pln" class="form-control rounded-pill" @bind-Value="@paymentDto.PaymentValuePLN" required />
                        <ValidationMessage For="@(() => paymentDto.PaymentValuePLN)" />
                    </div>

                    <div class="col-md-12 d-grid">
                        <button type="submit" class="btn btn-primary rounded-pill">Update Payment</button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}
else
{
    <p>No payment to display.</p>
}
@if (paymentEdited)
{
    <div class="alert alert-success" role="alert">
        Payment edited successfully.
    </div>
}

@code {
    [Parameter]
    public string id { get; set; }
    private PaymentDTO? paymentDto;
    private bool paymentEdited = false;

    protected override async Task OnInitializedAsync()
    {
        Guid.TryParse(id, out Guid result);
        paymentDto = await paymentService.GetPayment(result);
    }

    private void GoBack()
    {
        navigationManager.NavigateTo("/payments");
    }

    private async Task UpdatePayment()
    {
        var result = await paymentService.UpdatePayment(new PaymentUpdateDTO(paymentDto));
        paymentEdited = !string.IsNullOrWhiteSpace(result);
    }
}
