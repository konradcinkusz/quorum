@inherits BaseAdmin
@page "/adminlog/{id:int}"
@inject IAdminService AdminLogService

<h3>Admin Log Details</h3>

@if (AdminLog != null)
{
    <div class="card m-2 p-2">
        <div class="card-header">
            <h4 class="card-title">Admin Log Details</h4>
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-sm-4">
                    <label for="adminlog-id" class="form-label">Admin Log ID:</label>
                    <p class="form-control-plaintext" id="adminlog-id">@AdminLog.Id</p>
                </div>
                <div class="col-sm-4">
                    <label for="adminlog-createdat" class="form-label">Created At:</label>
                    <p class="form-control-plaintext" id="adminlog-createdat">@AdminLog.CreatedAt.ToString("g", CultureInfo.InvariantCulture)</p>
                </div>
                <div class="col-sm-4">
                    <label for="adminlog-action" class="form-label">Action:</label>
                    <p class="form-control-plaintext" id="adminlog-action">@AdminLog.Action</p>
                </div>
            </div>
            <hr />
            <div class="btn-group my-2" role="group">
                <button class="btn btn-primary btn-sm" type="button" @onclick="ToggleDetails">@ShowDetailsButtonText</button>
            </div>
            <div class="@DetailsCssClass">
                <hr />
                <div class="mb-2">
                    <label for="adminlog-values" class="form-label">Values:</label>
                    <textarea class="form-control" id="adminlog-values" rows="5" disabled>@AdminLog.Values</textarea>
                </div>
            </div>
        </div>
    </div>
    <style>
        .btn-group {
            display: inline-block;
            margin-right: 10px;
            border-radius: 5px;
            overflow: hidden;
        }

            .btn-group .btn {
                margin-right: 5px;
                border-radius: 0;
                transition: all 0.3s ease;
            }

                .btn-group .btn:last-child {
                    margin-right: 0;
                }

                .btn-group .btn:focus {
                    box-shadow: none;
                }

                .btn-group .btn:hover {
                    transform: translateY(-2px);
                }

                .btn-group .btn:active {
                    transform: translateY(0);
                }

            .btn-group .btn-secondary {
                background-color: #6c757d;
                border-color: #6c757d;
                color: #fff;
            }

                .btn-group .btn-secondary:hover {
                    background-color: #5a6268;
                    border-color: #545b62;
                }

            .btn-group .btn-primary {
                background-color: #007bff;
                border-color: #007bff;
                color: #fff;
            }

                .btn-group .btn-primary:hover {
                    background-color: #0069d9;
                    border-color: #0062cc;
                }

            .btn-group .btn:focus {
                outline: none;
            }

            .btn-group .btn:active,
            .btn-group .btn-primary:active {
                background-color: #0062cc;
                border-color: #005cbf;
                box-shadow: none;
                color: #fff;
            }

            .btn-group .btn-secondary:active {
                background-color: #545b62;
                border-color: #4e555b;
                box-shadow: none;
                color: #fff;
            }

    </style>
}
else
{
    <p>Loading...</p>
}

@code {
    [Parameter]
    public string ShowDetailsButtonText { get; set; } = "Show Details";

    [Parameter]
    public string GetDetailsButtonText { get; set; } = "Get Details";

    [Parameter]
    public AdminLogDTO AdminLog { get; set; }

    private string DetailsCssClass => showDetails ? "d-block" : "d-none";

    private bool showDetails = false;

    private void ToggleDetails()
    {
        showDetails = !showDetails;

        if (showDetails)
        {
            GetDetailsButtonText = "Hide Details";
            ShowDetailsButtonText = GetDetailsButtonText;
        }
        else
        {
            GetDetailsButtonText = "Get Details";
            ShowDetailsButtonText = GetDetailsButtonText;
        }
    }
}
