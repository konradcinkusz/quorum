@inherits ListPageBase<SignaturePoolDTO, SignaturePoolsSearchParamsDTO>
@attribute [Authorize(Policy = "AdminRoles")]
@inject IAdminService adminService
@page "/admin/signature-pools"

<_AuthorizationWrapper PageTitle="Signature pools list">
    <_PagedListWrapper PagedListDto="PagedListDTO" result="apiResponse">
        <BrowserSignaturePools Refresh="Refresh" SearchParams="searchParamsDTO" TotalPages="PagedListDTO.TotalPages" TotalItems="PagedListDTO.TotalItems" />
        <HeaderSignaturePools Refresh="Refresh" SearchParams="searchParamsDTO" />
        <_ForEachPagedListWrapper PagedListDto="PagedListDTO" result="apiResponse">
            <ReadSignaturePool SignaturePool="@context" Refresh="Refresh" />
        </_ForEachPagedListWrapper>
    </_PagedListWrapper>
</_AuthorizationWrapper>

@code {
    protected override void InitializeSearchParams() => searchParamsDTO = new SignaturePoolsSearchParamsDTO();

    protected override async Task<ApiResponse<PagedListDto<SignaturePoolDTO>>> Get(SignaturePoolsSearchParamsDTO searchParamsDTO)
        => await adminService.GetSignaturePoolsBySearchParams(searchParamsDTO);
}
