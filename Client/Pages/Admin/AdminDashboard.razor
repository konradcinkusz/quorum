@page "/admin/dashboard"
@using MR.Client.Services
@using Microsoft.AspNetCore.Authorization;
@inject IAdminService adminService;

<PageTitle>Admin dashboard</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid">
            <h1 class="mb-3">Dashboard</h1>
            <div class="row">
                <div class="col-md-12">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link active" href="payments"><span class="oi oi-list mr-2"></span> Payments</a>
                        </li>
                        <!-- Add more options here -->
                    </ul>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-md-12">
                    <h2>Payments Administration</h2>
                    <hr />
                    <button class="btn btn-primary" @onclick="SeedPayments">Seed Payments</button>
                    <!-- Add payment read page here -->
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-md-12">
                    <h2>Admin logs</h2>
                    <hr />
                    @if (AdminLogPagedListDto == null)
                    {
                        <_Loading LoadingText="Ładowanie listy płatności" />
                    }
                    else
                    {
                        <AdminBrowser Refresh="_refresh"
                                  QuerySearch="AdminLogQuerySearchDTO"></AdminBrowser>
                        @if (AdminLogPagedListDto.Items.Count == 0)
                        {
                            <p><em>Brak kwestii spełniających kryteria wyszukiwania...</em></p>
                        }
                        else
                        {
                            <br />
                            <br />
                            <_Paging QueryBase="AdminLogQuerySearchDTO"
                             RefreshList="_refresh"
                             TotalPages="AdminLogPagedListDto.TotalPages"
                             TotalItems="AdminLogPagedListDto.TotalItems"></_Paging>

                            <div class="content">
                                <div class="container">
                                    <div class="row align-content-center justify-content-center">
                                        @foreach (var p in AdminLogPagedListDto.Items)
                                        {
                                            <AdminLogReadForList AdminLog="p"></AdminLogReadForList>
                                        }
                                    </div>
                                </div>
                            </div>

                            <_Paging QueryBase="AdminLogQuerySearchDTO"
                             RefreshList="_refresh"
                             TotalPages="AdminLogPagedListDto.TotalPages"
                             TotalItems="AdminLogPagedListDto.TotalItems"></_Paging>
                        }
                    }
                </div>
            </div>
        </div>

    </Authorized>
    <NotAuthorized>
        <div class="m-2 p-2 font-weight-bold" style="background-color:grey">
            You must be logged as a super admin user at least to see these page
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private AdminLogSearchParamsDTO AdminLogQuerySearchDTO;
    private AdminLogPagedListDTO? AdminLogPagedListDto;

    protected override async Task OnInitializedAsync()
    {
        AdminLogQuerySearchDTO = new AdminLogSearchParamsDTO();
        await _refresh();
    }

    private async Task _refresh()
    {
        AdminLogPagedListDto = await adminService.GetAdminLogs(AdminLogQuerySearchDTO);
        AdminLogQuerySearchDTO.CurrentPage = AdminLogPagedListDto.CurrentPage;
        AdminLogQuerySearchDTO.PageSize = AdminLogPagedListDto.PageSize;
    }

    private async Task SeedPayments()
    {
        var result = await adminService.SeedPayments();
        if (result)
        {
            Console.WriteLine("Payments seeded successfully.");
        }
        else
        {
            Console.WriteLine("Failed to seed payments.");
        }
        await _refresh();
    }
}
