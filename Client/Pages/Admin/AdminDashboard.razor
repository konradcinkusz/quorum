@inherits BaseAdmin
@page "/admin/dashboard"
@using MR.Client.Services
@using Microsoft.AspNetCore.Authorization;
@inject IAdminService adminService;

<PageTitle>Admin dashboard</PageTitle>

<div class="container-fluid">
    <h1 class="mb-3">Dashboard</h1>

    <div class="row">
        <div class="col-md-12">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link active" href="payments"><span class="oi oi-list mr-2"></span> Payments</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Payment details -->
    <div class="row">
        <div class="btn-group my-2" role="group">
            <button class="btn btn-primary btn-sm" type="button" @onclick="ToggleDetails">@ShowDetailsButtonText</button>
        </div>
        <div class="@DetailsCssClass">
            <div class="row mt-4">
                <div class="col-md-12">
                    <div class="form-group">
                        <label for="countInput">Count:</label>
                        <input type="number" class="form-control" id="countInput" name="count" @bind-value="countValue">
                    </div>
                    <button class="btn btn-primary" @onclick="SeedPayments">Seed Payments</button>
                </div>

            </div>
            <div class="row mt-4">
                <div class="col-md-12">
                    <h2>Admin logs</h2>
                    <hr />
                    @if (AdminLogPagedListDto == null)
                    {
                        <_Loading LoadingText="Ładowanie listy płatności" />
                    }
                    else
                    {
                        <AdminBrowser Refresh="_refresh"
                                  QuerySearch="AdminLogQuerySearchDTO"></AdminBrowser>
                        @if (AdminLogPagedListDto.Items.Count == 0)
                        {
                            <p><em>Brak kwestii spełniających kryteria wyszukiwania...</em></p>
                        }
                        else
                        {
                            <br />
                            <br />
                            <_Paging QueryBase="AdminLogQuerySearchDTO"
                             RefreshList="_refresh"
                             TotalPages="AdminLogPagedListDto.TotalPages"
                             TotalItems="AdminLogPagedListDto.TotalItems"></_Paging>

                            <div class="content">
                                <div class="container">
                                    <div class="row align-content-center justify-content-center">
                                        @foreach (var p in AdminLogPagedListDto.Items)
                                        {
                                            <AdminLogReadForList AdminLog="p"></AdminLogReadForList>
                                        }
                                    </div>
                                </div>
                            </div>

                            <_Paging QueryBase="AdminLogQuerySearchDTO"
                             RefreshList="_refresh"
                             TotalPages="AdminLogPagedListDto.TotalPages"
                             TotalItems="AdminLogPagedListDto.TotalItems"></_Paging>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Subscriptions details -->
    <div class="row">
        <div class="btn-group my-2" role="group">
            <button class="btn btn-primary btn-sm" type="button" @onclick="ToggleSubscriptionDetails">@ShowSubscriptionDetailsButtonText</button>
        </div>

        <div class="col-md-12">
            <button class="btn btn-primary" @onclick="ActivateSubscription">Activate Subscription</button>
            <div>Activate Sub Count: @activatedSub</div>
        </div>

        <div class="@DetailsSubscriptionCssClass">
            <div class="row mt-4">
                <div class="col-md-12">
                    <SubscriptionAdminPage></SubscriptionAdminPage>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private AdminLogSearchParamsDTO AdminLogQuerySearchDTO;
    private AdminLogPagedListDTO? AdminLogPagedListDto;

    protected override async Task OnInitializedAsync()
    {
        AdminLogQuerySearchDTO = new AdminLogSearchParamsDTO();
        await _refresh();
    }

    private async Task _refresh()
    {
        AdminLogPagedListDto = await adminService.GetAdminLogs(AdminLogQuerySearchDTO);
        AdminLogQuerySearchDTO.CurrentPage = AdminLogPagedListDto.CurrentPage;
        AdminLogQuerySearchDTO.PageSize = AdminLogPagedListDto.PageSize;
    }

    private int activatedSub = 0;
    private async Task ActivateSubscription()
    {
        activatedSub = await adminService.ActivateSubscription();
    }

    private int countValue = 0;
    private async Task SeedPayments()
    {
        var result = await adminService.SeedPayments(new() { Count = countValue });
        if (result)
        {
            Console.WriteLine("Payments seeded successfully.");
        }
        else
        {
            Console.WriteLine("Failed to seed payments.");
        }
        await _refresh();
    }

    private string ShowDetailsButtonText { get; set; } = "Show payments details";
    private string GetDetailsButtonText { get; set; } = "Get payments details etails";
    private string DetailsCssClass => showDetails ? "d-block" : "d-none";
    private bool showDetails = false;
    private void ToggleDetails()
    {
        showDetails = !showDetails;

        if (showDetails)
        {
            GetDetailsButtonText = "Hide payments details";
            ShowDetailsButtonText = GetDetailsButtonText;
        }
        else
        {
            GetDetailsButtonText = "Get payments details";
            ShowDetailsButtonText = GetDetailsButtonText;
        }
    }


    private string ShowSubscriptionDetailsButtonText { get; set; } = "Show Subscription details";
    private string GetSubscriptionDetailsButtonText { get; set; } = "Get Subscription details etails";
    private string DetailsSubscriptionCssClass => showSubscriptionDetails ? "d-block" : "d-none";
    private bool showSubscriptionDetails = false;
    private void ToggleSubscriptionDetails()
    {
        showSubscriptionDetails = !showSubscriptionDetails;

        if (showSubscriptionDetails)
        {
            GetSubscriptionDetailsButtonText = "Hide Subscription details";
            ShowSubscriptionDetailsButtonText = GetSubscriptionDetailsButtonText;
        }
        else
        {
            GetSubscriptionDetailsButtonText = "Get Subscription details";
            ShowSubscriptionDetailsButtonText = GetSubscriptionDetailsButtonText;
        }
    }
}
