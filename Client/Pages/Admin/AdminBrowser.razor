@inherits BaseAdmin
<div class="row domain-search bg-green rounded">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <h2 class="form-title">Search admin logs</h2>
            </div>
            <div class="col-md-9">
                <div class="row g-3">
                    <div class="col-md-9 col-sm-12">
                        <input type="search" class="form-control rounded-pill" placeholder="Values phrase" @bind-value="phrase" @bind-value:event="oninput" required>
                    </div>
                    <div class="col-md-9 col-sm-12">
                        <input type="search" class="form-control rounded-pill" placeholder="Action" @bind-value="action" @bind-value:event="oninput" required>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <button type="submit" class="btn btn-outline-light btn-block rounded-pill" @onclick="RefreshInternal"><span class="flex-center search">Search</span></button>
                    </div>
                </div>

                <div class="centered mt-2">
                    <div> <input type="checkbox" name="r1" id="r1" @bind-value="lastHour" @bind-value:event="onchange"> <label for="r1" class="text-white font-weight-bold">Last hour</label> </div>
                    <div> <input type="checkbox" name="r2" id="r2" @bind-value="lastMonth" @bind-value:event="onchange"> <label for="r2" class="text-white font-weight-bold">Last month</label> </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public AdminLogSearchParamsDTO QuerySearch { get; set; }
    [Parameter]
    public EventCallback Refresh { get; set; }

    string phrase = string.Empty;
    string action = string.Empty;

    bool lastMonth = false;

    bool lastHour = false;

    async Task RefreshInternal()
    {
        QuerySearch.LastHour = lastHour;
        QuerySearch.LastMonth = lastMonth;
        QuerySearch.ValuesText = phrase;
        QuerySearch.Action = action;

        await Refresh.InvokeAsync();
    }
}
