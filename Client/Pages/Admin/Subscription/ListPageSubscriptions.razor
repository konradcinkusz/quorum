@inherits BaseAdmin
@page "/admin/subscriptions"
@inject IAdminService subscriptionService
@inject IPaymentService paymentService

<PageTitle>Subscription list admin page</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (SubscriptionPagedListDto == null)
        {
            <_Loading LoadingText="Ładowanie listy subskrypcji" />
        }
        else
        {
            <BrowserSubscription SearchParams="SubscriptionSearchParamsDTO" Refresh="_refresh" />
            @if (result != null && !result.Success)
            {
                <hr />
                <_ApiResponse T="SubscriptionPagedListDTO" result="result" />
            }
            @if (SubscriptionPagedListDto.Items.Count == 0)
            {
                <_Info Description="No subs for that search params" />
            }
            else
            {
                <HeaderSubscription SearchParams="SubscriptionSearchParamsDTO" Refresh="_refresh" />
                @if (response != null && !response.Success)
                {
                    <_ApiResponse T="bool" result="response" />
                }
                @if (activationResponse != null && !activationResponse.Success)
                {
                    <_ApiResponse T="bool" result="activationResponse" />
                }
                <div class="content">
                    <div class="container">
                        <div class="row align-content-center justify-content-center">
                            @foreach (var p in SubscriptionPagedListDto.Items)
                            {
                                <ReadSubscription DTO="p" AcceptPayment="acceptPayment" ActivateSubscription="activateSubscription" />
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <_Info />
    </NotAuthorized>
</AuthorizeView>

@code {
    private SubscriptionSearchParamsDTO SubscriptionSearchParamsDTO;
    private SubscriptionPagedListDTO? SubscriptionPagedListDto;

    private ApiResponse<SubscriptionPagedListDTO> result = null;

    protected override async Task OnInitializedAsync()
    {
        SubscriptionSearchParamsDTO = new SubscriptionSearchParamsDTO();
        await _refresh();
    }

    private async Task _refresh()
    {
        result = await subscriptionService.GetSubscriptionsBySearchParams(SubscriptionSearchParamsDTO);
        SubscriptionPagedListDto = result.Data;
        SubscriptionSearchParamsDTO.CurrentPage = SubscriptionPagedListDto.CurrentPage;
        SubscriptionSearchParamsDTO.PageSize = SubscriptionPagedListDto.PageSize;
    }
    
    private ApiResponse<bool> response = null;
    private async Task acceptPayment(Guid paymentId)
    {
        response = await paymentService.AcceptPayment(paymentId);
        await _refresh();
    }

    private ApiResponse<bool> activationResponse = null;
    private async Task activateSubscription(string subId)
    {
        response = await subscriptionService.ActivateSubscription(subId);
        await _refresh();
    }

    private ApiResponse<bool> deactivationResponse = null;
    private async Task deactivateSubscription(string subId)
    {
        response = await subscriptionService.DeactivateSubscription(subId);
        await _refresh();
    }
}
