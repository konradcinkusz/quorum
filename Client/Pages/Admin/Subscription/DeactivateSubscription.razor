@inherits BaseAdmin
@page "/admin/subscription/deactivate-subscriptions"

<PageTitle>Deactivate subscriptions</PageTitle>

@if (result != null && result.Data?.TotalItems > 0)
{
    <div class="car MRCard">
        <div class="form-group MRForm-group">
            <label for="countInput">Active count: </label>@result.Data.TotalItems
        </div>
    </div>
}

@if (result != null && result.Success && result.Data?.Items.Count > 0)
{
    <div class="content">
        <div class="container">
            <div class="row align-content-center justify-content-center">
                @foreach (var p in result.Data.Items)
                {
                    <ReadSubscription SubscriptionDTO="p" />
                    <button class="btn btn-primary MRBtn" @onclick="()=>Submit(p.ApplicationUserId)">Force dectivate</button>
                }
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <_Info Description="@message" />
}

@code {
    private ApiResponse<SubscriptionPagedListDTO> result;

    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        result = await adminService.GetSubscriptionsThatCouldBeDeactivate();

        if (result.Data.TotalItems == 0)
        {
            message = "No subscriptions to activate";
        }
    }

    private async Task Submit(string applicationUserId)
    {
        var res = await adminService.DeactivateSubscription(applicationUserId);

        if (res.Success && res.Data.Items.Count == result.Data.Items.Count)
        {
            message = "All subscriptions deactivated successfully";
            result = new ApiResponse<SubscriptionPagedListDTO>() { Success = false };
        }
        else
        {
            message = "Something went wrong, not all subscriptions deactivated";
        }
    }
}
