@inherits BaseAdmin
@page "/admin/seeds/payments"


<PageTitle>Seed payments</PageTitle>

<div class="car MRCard">
    <div class="form-group MRForm-group">
        <label for="countInput">Count:</label>
        <input type="range" class="form-control" id="countInput" name="count" 
        value="@count" min="1" max="15" step="1" @oninput="UpdateCount">
    </div>
    <button class="btn btn-primary MRBtn" @onclick="Seed">Seed Payments</button>
    <div class="count-display MRCount-display">
        <span class="count-label MRCount-label">Selected Count:</span>
        <span class="count-value MRCount-value">@count</span>
    </div>
</div>

@if (result != null)
{
    @if (result.Success)
    {
        <div class="content">
            <div class="container">
                <div class="row align-content-center justify-content-center">
                    @foreach (var p in result.Data.Items)
                    {
                        <ReadPayment dto="p"></ReadPayment>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <_Loading LoadingText="Payments list loading"></_Loading>
    }
}

@code {
    private int count = 1;

    ApiResponse<PaymentPagedListDTO> result = null;
    private async Task Seed()
    {
        result = new ApiResponse<PaymentPagedListDTO>() { Success = false };
        result = await adminService.SeedPayments(new() { Count = count });
    }

    void UpdateCount(ChangeEventArgs e)
    {
        count = Convert.ToInt32(e.Value);
    }
}
