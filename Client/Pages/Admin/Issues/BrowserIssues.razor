<div class="row domain-search bg-green rounded row-spacing">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="row g-3 mt-2">
                    <div class="col-md-9 col-sm-12">
                        <input type="search" class="form-control rounded-pill" placeholder="User name" @bind-value="SearchParams.CreatedByEmail" @bind-value:event="oninput">
                    </div>
                    <div class="col-md-3 col-sm-12 text-end">
                        <button type="submit" class="btn btn-outline-light btn-block rounded-pill" @onclick="ClearQuery"><span class="flex-center search">Clear</span></button>
                        <button type="submit" class="btn btn-outline-light btn-block rounded-pill" @onclick="async () => await Refresh.InvokeAsync()"><span class="flex-center search">Search</span></button>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-12">
                        <input type="text" id="title" class="form-control rounded-pill" @bind="SearchParams.IssueId" @bind:event="oninput">
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-3 col-sm-12">
                        <input type="text" id="title" class="form-control rounded-pill" @bind="SearchParams.Title" @bind:event="oninput">
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <input type="text" id="question" class="form-control rounded-pill" @bind="SearchParams.Question" @bind:event="oninput">
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <select id="isVerifyByAdmin" class="form-control rounded-pill" @onchange="OnVerifyByAdminChanged">
                            <option value="">-- Select Verification --</option>
                            <option value="true" selected="@SearchParams.IsVerifyByAdmin">Yes</option>
                            <option value="false" selected="@(SearchParams.IsVerifyByAdmin == false)">No</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <select id="IssueVisibility" class="form-control rounded-pill" @bind="SearchParams.IssueVisibility" @bind:event="onchange">
                            <option value="">-- Select Issue Status --</option>
                            @foreach (var status in Enum.GetValues(typeof(IssueVisibilityEnum)))
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-3 col-sm-12">
                        <input type="number" id="ratingValue" class="form-control rounded-pill" @bind="SearchParams.RatingValue" @bind:event="oninput">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <_Paging QueryBase="SearchParams"
                     RefreshList="async () => await Refresh.InvokeAsync()"
                     TotalPages="TotalPages"
                     TotalItems="TotalItems"></_Paging>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public IssueSearchParamsDTO SearchParams { get; set; }
    [Parameter]
    public EventCallback Refresh { get; set; }
    [Parameter]
    public int TotalPages { get; set; }
    [Parameter]
    public int TotalItems { get; set; } = 0;

    private async Task ClearQuery()
    {
        SearchParams.IssueId = null;
        SearchParams.CreatedByEmail = null;
        SearchParams.Title = null;
        SearchParams.Question = null;
        SearchParams.IsVerifyByAdmin = null;
        SearchParams.IssueVisibility = null;
        SearchParams.RatingValue = null;
        SearchParams.QuarterYear = null;
        SearchParams.QuarterNumber = null;
        SearchParams.PaymentOptions = null;

        await Refresh.InvokeAsync();
    }

    public bool? IsVerifyByAdmin
    {
        get => SearchParams.IsVerifyByAdmin;
        set => SearchParams.IsVerifyByAdmin = value;
    }

    private void OnVerifyByAdminChanged(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool result))
        {
            IsVerifyByAdmin = result;
        }
        else
        {
            IsVerifyByAdmin = null;
        }
    }
}
