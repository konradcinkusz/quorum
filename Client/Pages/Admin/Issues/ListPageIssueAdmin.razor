@inherits BaseAdmin
@page "/admin/issues"

<_AuthorizationWrapper PageTitle="Issue list">
    <_PagedListWrapper PagedListDto="IssuePagedListDto" result="result">
        <BrowserIssues Refresh="_refresh" SearchParams="IssueSearchParamsDTO" TotalPages="IssuePagedListDto.TotalPages" TotalItems="IssuePagedListDto.TotalItems" />
        <HeaderIssues Refresh="_refresh" SearchParams="IssueSearchParamsDTO" />
        <div class="content">
            <div class="container">
                <div class="row align-content-center justify-content-center">
                    @foreach (var p in IssuePagedListDto.Items)
                    {
                        <ReadIssueAdmin dto="p" Delete="Delete" AcceptInitialPaymentByPaymentGuid="AcceptPaymentByPaymentGuid" SetPendingPaymentStatusByPaymentGuid="SetPendingPaymentStatusByPaymentGuid" />
                    }
                    @if (IssuePagedListDto.Items.Count == 0)
                    {
                        <span>There is nothing to show...</span>
                    }
                </div>
            </div>
        </div>
    </_PagedListWrapper>
</_AuthorizationWrapper>

@code {
    private IssueSearchParamsDTO IssueSearchParamsDTO;
    private PagedListDto<IssueReadDTO>? IssuePagedListDto;
    private ApiResponse<PagedListDto<IssueReadDTO>> result = null;

    protected override async Task OnInitializedAsync()
    {
        IssueSearchParamsDTO = new IssueSearchParamsDTO();
        await _refresh();
    }

    private async Task _refresh()
    {
        result = await adminService.GetIssuesBySearchParams(IssueSearchParamsDTO);
        IssuePagedListDto = result.Data;
        IssueSearchParamsDTO.CurrentPage = IssuePagedListDto.CurrentPage;
        IssueSearchParamsDTO.PageSize = IssuePagedListDto.PageSize;
    }

    private async Task Delete(Guid issueId)
    {
        await adminService.ForceDeleteIssue(issueId);
        await _refresh();
    }

    private async Task AcceptPaymentByPaymentGuid(Guid paymentId)
    {
        await paymentService.AcceptIssueInitialPayment(paymentId);
        await _refresh();
    }

    private async Task SetPendingPaymentStatusByPaymentGuid(Guid paymentId)
    {
        await paymentService.SetPaymentStatus(paymentId, PaymentStatusEnum.Pending);
        await _refresh();
    }
}
