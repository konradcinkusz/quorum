@inherits Browser<QuarterSearchParamsDTO>

<div class="row domain-search bg-green rounded row-spacing">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="row g-1 mt-2">
                    <div class="col-md-3 col-sm-12">
                        <select id="year" class="form-control rounded-pill" @bind="SearchParams.Year" @bind:event="onchange">
                            <option value="">-- Select Year --</option>
                            <option value="2021">2021</option>
                            <option value="2022">2022</option>
                            <option value="2023">2023</option>
                            <option value="2023">2024</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <select id="quarter" class="form-control rounded-pill" @bind="SearchParams.Quarter" @bind:event="onchange">
                            <option value="">-- Select Quarter --</option>
                            <option value="1">Q1</option>
                            <option value="2">Q2</option>
                            <option value="3">Q3</option>
                            <option value="4">Q4</option>
                        </select>
                    </div>
                    <div class="col-md-6 col-sm-12 text-end">
                        <button type="submit" class="btn btn-outline-light btn-block rounded-pill" @onclick="async () => await base.ClearQuery()"><span class="flex-center search">Clear</span></button>
                        <button type="submit" class="btn btn-outline-light btn-block rounded-pill" @onclick="async () => await Refresh.InvokeAsync()"><span class="flex-center search">Search</span></button>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <_Paging QueryBase="SearchParams" RefreshList="async () => await Refresh.InvokeAsync()" TotalPages="TotalPages" TotalItems="TotalItems" />
        </div>
    </div>
</div>