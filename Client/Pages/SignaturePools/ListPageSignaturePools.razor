@inherits BaseAdmin
@page "/admin/SignaturePools"
@inject IAdminService adminService

<PageTitle>SignaturePools list</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (SignaturePoolPagedListDto == null)
        {
            <_Loading LoadingText="Ładowanie listy płatności" />
        }
        else
        {
            <BrowserSignaturePools Refresh="_refresh"
                               SearchParams="SignaturePoolsearchParamsDTO"
                               TotalPages="SignaturePoolPagedListDto.TotalPages"
                               TotalItems="SignaturePoolPagedListDto.TotalItems" />
            @if (result != null && !result.Success)
            {
                <hr />
                <_ApiResponse T="SignaturePoolsPagedListDTO" result="result" />
            }
            @if (SignaturePoolPagedListDto.Items.Count == 0)
            {
                <hr />
                <div class="alert alert-danger" role="alert">
                    <p><em>Brak kwestii spełniających kryteria wyszukiwania...</em></p>
                </div>
            }
            else
            {
                <HeaderSignaturePools Refresh="_refresh"
                              SearchParams="SignaturePoolsearchParamsDTO" />
                <div class="content">
                    <div class="container">
                        <div class="row align-content-center justify-content-center">
                            @foreach (var p in SignaturePoolPagedListDto.Items)
                            {
                                <ReadSignaturePool SignaturePool="p"  Refresh="_refresh"/>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <div class="m-2 p-2 font-weight-bold" style="background-color:grey">
            You must be logged as a super admin user at least to see these page
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private SignaturePoolsSearchParamsDTO SignaturePoolsearchParamsDTO;
    private SignaturePoolsPagedListDTO? SignaturePoolPagedListDto;

    private ApiResponse<SignaturePoolsPagedListDTO> result = null;

    protected override async Task OnInitializedAsync()
    {
        SignaturePoolsearchParamsDTO = new SignaturePoolsSearchParamsDTO();
        await _refresh();
    }

    async Task _refresh()
    {
        result = await adminService.GetSignaturePools(SignaturePoolsearchParamsDTO);
        SignaturePoolPagedListDto = result.Data;
        SignaturePoolsearchParamsDTO.CurrentPage = SignaturePoolPagedListDto.CurrentPage;
        SignaturePoolsearchParamsDTO.PageSize = SignaturePoolPagedListDto.PageSize;
    }
}
