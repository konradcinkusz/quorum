@attribute [Authorize]
@inject IIssueService issueService
@page "/issue/my-issues"

<PageTitle>Yout Issues list</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (IssuePagedListDto == null)
        {
            <_Loading LoadingText="Ładowanie listy płatności" />
        }
        else
        {
            @if (result != null && !result.Success)
            {
                <hr />
                <_ApiResponse T="PagedListDto<IssueReadDTO>" result="result" />
            }
            @if (IssuePagedListDto.Items.Count == 0)
            {
                <hr />
                <div class="alert alert-danger" role="alert">
                    <p><em>Brak danych spełniających kryteria wyszukiwania...</em></p>
                </div>
            }
            else
            {
                <div class="content">
                    <div class="container">
                        <div class="row align-content-center justify-content-center">
                            @foreach (var dto in IssuePagedListDto.Items)
                            {
                                <_CustomIssueCard dto="dto"
                                                  ShowButtons="true"
                                                  ShowStatus="true">

                                    @if (!dto.Id.IsNullOrEmpty())
                                    {
                                        @if (dto.InitialPayment == null)
                                        {
                                            <button type="button" @onclick="@(async () => await Pay(dto.Id))" class="btn btn-primary rounded-pill m-1 inactive-subscription-button"
                                                    disabled="@(!isActiveSubscription)" data-bs-toggle="tooltip" title="@(isActiveSubscription ? string.Empty : "You don't have an active subscription yet")">
                                                Pay
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" @onclick="@(async () => await Publish(dto.Id))" class="btn btn-primary rounded-pill m-1 inactive-subscription-button"
                                                    disabled="@(!isActiveSubscription)" data-bs-toggle="tooltip" title="@(isActiveSubscription ? string.Empty : "You don't have an active subscription yet")">
                                                Publish
                                            </button>
                                            <button type="button" class="btn btn-primary rounded-pill m-1 disabled">
                                                Already paid
                                            </button>
                                        }
                                    }
                                </_CustomIssueCard>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <div class="m-2 p-2 font-weight-bold" style="background-color:grey">
            You must be logged as a super admin user at least to see these page
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthTask { get; set; }

    private IssueSearchParamsDTO IssueSearchParamsDTO;
    private PagedListDto<IssueReadDTO>? IssuePagedListDto;

    private ApiResponse<PagedListDto<IssueReadDTO>> result = null;

    private bool isActiveSubscription = false;

    protected override async Task OnInitializedAsync()
    {
        var tuple = AuthHelper.IsActiveSubscription(await AuthTask);
        isActiveSubscription = tuple.Item1;
        IssueSearchParamsDTO = new IssueSearchParamsDTO();
        await _refresh();
    }

    async Task _refresh()
    {
        result = await issueService.GetMyIssuesBySearchParams(IssueSearchParamsDTO);
        IssuePagedListDto = result.Data;
        IssueSearchParamsDTO.CurrentPage = IssuePagedListDto.CurrentPage;
        IssueSearchParamsDTO.PageSize = IssuePagedListDto.PageSize;
    }

    private ApiResponse<bool> published = null;
    private async Task Publish(Guid id)
    {
        if (!id.IsNullOrEmpty() && isActiveSubscription)
        {
            published = await issueService.PublishIssue(id);
        }
    }

    private ApiResponse<bool> paid = null;
    private async Task Pay(Guid id)
    {
        if (!id.IsNullOrEmpty() && isActiveSubscription)
        {
            paid = await issueService.PayForAnIssue(id, new IssuePayDTO());
        }
    }
}
