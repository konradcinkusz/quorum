@inherits BaseAdmin
@page "/admin/create-issue-by-admin"
@inject NavigationManager navigationManager

<PageTitle>Admin Issue Create or Edit</PageTitle>

<div class="card shadow rounded-3">
    <div class="card-header bg-primary text-white py-3 rounded-3">
        <h5 class="card-title mb-0">Create or Edit Issue by Admin</h5>
    </div>

    <div class="card-body">
        <EditForm Model="@dto" OnValidSubmit="@Create">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label for="email-value" class="form-label">Application User Id</label>
                    <InputText id="email-value" class="form-control rounded-pill" ValueExpression="@(()=>dto.ApplicationUserId)" Value="@dto.ApplicationUserId" ValueChanged="@((string value) => OnApplicationUserIdValueChanged(value))" required />
                    <ValidationMessage For="@(() => dto.ApplicationUserId)" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="title-value" class="form-label">Title</label>
                    <InputText id="title-value" class="form-control rounded-pill" @bind-Value="@dto.Title" @oninput="@((ChangeEventArgs e)=>{dto.Title = e?.Value?.ToString()??"";})" required />
                    <ValidationMessage For="@(() => dto.Title)" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="question-value" class="form-label">Question</label>
                    <InputText id="question-value" class="form-control rounded-pill" @bind-Value="@dto.Question" @oninput="@((ChangeEventArgs e)=>{dto.Question = e?.Value?.ToString()??"";})" required />
                    <ValidationMessage For="@(() => dto.Question)" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="verify-value" class="form-label">Is Verified by Admin</label>
                    <InputCheckbox id="verify-value" class="form-check-input" @bind-Value="@dto.IsVerifyByAdmin" />
                    <ValidationMessage For="@(() => dto.IsVerifyByAdmin)" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="status-value" class="form-label">Issue Status</label>
                    <select id="status-value" class="form-select rounded-pill" @bind="@dto.IssueVisibility" required>
                        <option value="">-- Select Issue Status --</option>
                        @foreach (var status in Enum.GetValues(typeof(IssueVisibilityEnum)))
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => dto.IssueVisibility)" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="rating-value" class="form-label">Rating Value</label>
                    <InputNumber id="rating-value" class="form-control rounded-pill" @bind-Value="@dto.RatingValue" required />
                    <ValidationMessage For="@(() => dto.RatingValue)" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="icon-value" class="form-label">Choose icon</label>
                    <_IconPicker Icon="@dto.Icon" IconChanged="HandleIconChanged" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="color-value" class="form-label">Choose color</label>
                    <_ColorPicker SelectedColor="@dto.BackgroundColor" SelectedColorChanged="@HandleColorChanged" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="process-value" class="form-label">Issue Processing Status</label>
                    <select id="process-value" class="form-select rounded-pill" @bind="@dto.IssueProcess" required>
                        <option value="">-- Select Issue process --</option>
                        @foreach (var status in Enum.GetValues(typeof(IssueProcessEnum)))
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                    <ValidationMessage For="@(() => dto.IssueProcess)" />
                </div>

                <div class="col-md-6 d-grid">
                    <button type="submit" class="btn btn-primary rounded-pill">Save Changes</button>
                </div>
            </div>
        </EditForm>
        <div class="row justify-content-center">
            <div class="col-12 text-center">
                <hr />
                <h5>Preview</h5>
            </div>
            <div class="col-12">
                <div class="row d-flex justify-content-center">
                    <_CustomIssueCard BackgroundColor="@dto.BackgroundColor"
                                      Title="@dto.Title" Icon="@dto.Icon"
                                      Text="@dto.Question"
                                      ApplicationUserEmail="@dto.ApplicationUserEmail"
                                      IsVerifyByAdmin="@dto.IsVerifyByAdmin"
                                      IssueVisibility="@dto.IssueVisibility"
                                      RatingValue="@dto.RatingValue" />
                </div>
            </div>
        </div>
    </div>
</div>

@if (result != null)
{
    <_ApiResponse T="Guid" result="result" />
}
@if (emailResponse != null)
{
    <_ApiResponse T="string" result="emailResponse" />
}
@code {
    private IssueAdminCreateDTO dto = new IssueAdminCreateDTO();

    private ApiResponse<Guid> result = null;

    private void HandleIconChanged(string selectedIcon)
    {
        dto.Icon = selectedIcon;
    }

    private void HandleColorChanged(string selectedColor)
    {
        dto.BackgroundColor = selectedColor;
    }

    private async Task Create()
    {
        result = await adminService.CreateIssue(dto);

        if (result != null)
        {
            navigationManager.NavigateTo($"/issue/edit-issue/{result.Data}");
        }
    }

    private ApiResponse<string> emailResponse = null;
    private async Task RefreshEmail()
    {
        emailResponse = await adminService.GetUserEmailByUserId(dto.ApplicationUserId);
        if (emailResponse.Success)
            dto.ApplicationUserEmail = emailResponse.Data;
    }

    private async Task OnApplicationUserIdValueChanged(string value)
    {
        dto.ApplicationUserId = value;
        if (Guid.TryParse(value, out Guid id))
        {
            emailResponse = await adminService.GetUserEmailByUserId(value);
            if (emailResponse.Success)
                dto.ApplicationUserEmail = emailResponse.Data;
        }
        else
        {
            dto.ApplicationUserEmail = string.Empty;
        }
    }
}
