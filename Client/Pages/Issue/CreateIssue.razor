@attribute [Authorize]
@page "/issue/create-issue"
@inject IIssueService issueService
@inject NavigationManager navigationManager

<PageTitle>Add new Issue</PageTitle>

<div class="card shadow rounded-3">
    <div class="card-header bg-primary text-white py-3 rounded-3">
        <h5 class="card-title mb-0 text-center">Add new Issue</h5>
    </div>

    <div class="card-body">
        <EditForm Model="@dto" OnValidSubmit="@Create">
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (currentPage == 1)
            {
                <div class="row">
                    <div class="col-12">
                        <label for="title-value" class="form-label">Title</label>
                        <InputText id="title-value" class="form-control rounded-pill" @bind-Value="@dto.Title" @oninput="@((ChangeEventArgs e)=>{dto.Title = e?.Value?.ToString()??"";})" required />
                        <ValidationMessage For="@(() => dto.Title)" />
                    </div>
                </div>
            }
            else if (currentPage == 2)
            {
                <div class="row">
                    <div class="col-12">
                        <label for="question-value" class="form-label">Question</label>
                        <InputTextArea id="question-value" class="form-control rounded-pill" @bind-Value="@dto.Question" @oninput="@((ChangeEventArgs e)=>{dto.Question = e?.Value?.ToString()??"";})" required />
                        <ValidationMessage For="@(() => dto.Question)" />
                    </div>
                </div>
            }
            else if (currentPage == 3)
            {
                <div class="row">
                    <div class="col-12">
                        <label for="icon-value" class="form-label">Choose icon</label>
                        <_IconPicker Icon="@dto.Icon" IconChanged="HandleIconChanged" />
                    </div>
                </div>
            }
            else if (currentPage == 4)
            {
                <div class="row">
                    <div class="col-12">
                        <label for="color-value" class="form-label">Choose color</label>
                        <_ColorPicker SelectedColor="@dto.BackgroundColor" SelectedColorChanged="@HandleColorChanged" />
                    </div>
                </div>
            }

            <div class="row justify-content-center">
                <div class="col-sm-12 col-md-6 d-grid">
                    @if (currentPage > 1)
                    {
                        <button type="button" class="btn btn-primary rounded-pill" @onclick="PreviousPage">
                            Previous
                        </button>
                    }
                </div>
                <div class="col-sm-12 col-md-6 d-grid">
                    @if (currentPage < 4)
                    {
                        <button type="button" class="btn btn-primary rounded-pill" @onclick="NextPage">
                            Next
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary rounded-pill">
                            Save Changes
                        </button>
                    }
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-12">
                    <div class="progress mt-4">
                        <div class="progress-bar" role="progressbar" style="width: @(currentPage * 25)%;"
                             aria-valuenow="@currentPage" aria-valuemin="1" aria-valuemax="4">
                            @($"{(currentPage * 25)}% Complete")
                        </div>
                    </div>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-12 text-center">
                    <hr />
                    <h5>Preview</h5>
                </div>
                <div class="row d-flex justify-content-center">
                    <_CustomIssueCard BackgroundColor="@dto.BackgroundColor"
                                      Title="@dto.Title" Icon="@dto.Icon"
                                      Text="@dto.Question"
                                      ApplicationUserEmail="@email"
                                      IsVerifyByAdmin="false"
                                      IssueVisibility="@IssueVisibilityEnum.VisibleOnlyToMe"
                                      RatingValue="0"
                                      ColsDefinition="col-12" />
                </div>
            </div>

        </EditForm>
    </div>
</div>

@if (result != null)
{
    <_ApiResponse T="Guid" result="result" />
}

@if (dto.InitialPaymnet != null)
{
    <ReadPayment Payment="dto.InitialPaymnet"></ReadPayment>
}

<style>
    .inactive-subscription-button {
        background-color: @(!isActiveSubscription ? "grey" : "#007bff");
    }
</style>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthTask { get; set; }

    private bool isActiveSubscription = false;
    private string email;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        var authState = await AuthTask;
        var user = authState.User;
        var claim = user.Claims.FirstOrDefault(x => x.Type == "isActiveSubscription");
        if (claim != null && bool.TryParse(claim.Value, out bool subscriptionF))
        {
            isActiveSubscription = subscriptionF;
        }

        email = user.Claims.FirstOrDefault(x => x.Type == "name")?.Value ?? string.Empty;
    }

    private IssueCreateDTO dto = new IssueCreateDTO();

    private void HandleIconChanged(string selectedIcon)
    {
        dto.Icon = selectedIcon;
    }

    private void HandleColorChanged(string selectedColor)
    {
        dto.BackgroundColor = selectedColor;
    }

    private ApiResponse<Guid> result = null;
    private async Task Create()
    {
        result = await issueService.CreateIssue(dto);

        if (result != null)
        {
            result = await issueService.ChangeIssueProcessStatus(result.Data, IssueProcessEnum.Created);
            if (result != null)
            {
                navigationManager.NavigateTo($"/issue/edit-issue/{result.Data}");
            }
        }
    }

    private int currentPage = 1;

    private void NextPage()
    {
        if (currentPage < 4)
        {
            currentPage++;
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }
}
