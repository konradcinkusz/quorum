<div class="col-sm-12 col-md-6 col-lg-4">
    <div class="card border-0 shadow-sm rounded mb-4" style="background-color: @BackgroundColor;">
        <div class="card-body text-center">
            <div class="card-header">
                <div class="d-flex justify-content-between">
                    <span class="text-end fw-bold">@RatingValue</span>
                </div>
            </div>
            <h5 class="card-title mb-0">@Title</h5>
            <span class="@IconClass"></span>
            <p class="card-text">@Text</p>
            <div class="card-footer text-muted">
                <div class="d-flex justify-content-between">
                    <span class="text-start">@ApplicationUserEmail</span>
                    <span class="text-center"><span class="@VerifiedByAdminIcon" /></span>
                </div>
                <div class="text-end">
                    <span class="@GetIssueStatusIcon(IssueStatus)"></span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string BackgroundColor { get; set; }

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public string Icon { get; set; }

    [Parameter]
    public string Text { get; set; }

    [Parameter]
    public string ApplicationUserEmail { get; set; }

    [Parameter]
    public bool IsVerifyByAdmin { get; set; }

    [Parameter]
    public int RatingValue { get; set; }

    [Parameter]
    public IssueStatusEnum IssueStatus { get; set; }

    private string VerifiedByAdminIcon => IsVerifyByAdmin ? "oi oi-check" : "oi oi-x";

    private string IconClass => $"oi {Icon} oi-3x mb-3 icon-lg";

    private string GetIssueStatusIcon(IssueStatusEnum status)
    {
        return status switch
        {
            IssueStatusEnum.NotVisible => "oi oi-caret-left oi-3x mb-3 icon-lg",
            IssueStatusEnum.VisibleOnlyToMe => "oi oi-eye oi-3x mb-3 icon-lg",
            IssueStatusEnum.VisibleForAll => "oi oi-compass oi-3x mb-3 icon-lg",
            IssueStatusEnum.OutOfCurrentQuarter => "oi oi-bell oi-3x mb-3 icon-lg",
            IssueStatusEnum.OutOfCurrentQuarterVisibleOnlyToMe => "oi oi-yen oi-3x mb-3 icon-lg",
            _ => string.Empty,
        };
    }
}