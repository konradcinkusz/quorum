<div class="@ColsDefinition">
    <div class="card border-0 shadow rounded-lg mb-4" style="background-color: @BackgroundColor;">
        <div class="card-body text-center">
            <div class="card-header">
                <h5 class="card-title fw-bold fs-5">@Title</h5>
            </div>
            <div class="mt-3">
                <span class="@IconClass"></span>
            </div>
            <p class="card-text mt-3">@Text</p>
            <div class="card-footer text-muted mt-3">
                <div class="d-flex justify-content-between">
                    <span class="text-start black-text fs-6">@ApplicationUserEmail</span>
                    <span class="text-center"><span class="@VerifiedByAdminIcon"></span></span>
                </div>
            </div>
            <div class="card-footer text-muted mt-3">
                <div class="d-flex justify-content-between">
                    <span class="text-end fw-bold black-text fs-6">@RatingValue</span>
                </div>
            </div>
            <div class="card-footer text-muted mt-3">
                @FooterContent
            </div>
        </div>
    </div>
    <div>
        <div class="d-flex justify-content-between">
            @if (Id != Guid.Empty)
            {
                <a href="/issue/edit-issue/@Id.ToString()" class="btn btn-secondary btn-sm me-2">
                    Edit
                </a>
            }
        </div>

        <div class="card">
            <div class="card-body">
                <span>
                    Status: @EnumParser.GetEnumString(IssueVisibility)
                </span>
                <span class="@GetIssueStatusIcon(IssueVisibility)" style="float: right;">
                </span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string ColsDefinition { get; set; } = "col-sm-12 col-md-6 col-lg-4";

    [Parameter]
    public string BackgroundColor { get; set; }

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public string Icon { get; set; }

    [Parameter]
    public string Text { get; set; }

    [Parameter]
    public string FooterContent { get; set; }

    [Parameter]
    public string ApplicationUserEmail { get; set; }

    [Parameter]
    public bool IsVerifyByAdmin { get; set; }

    [Parameter]
    public int RatingValue { get; set; }

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public IssueVisibilityEnum IssueVisibility { get; set; }

    private string VerifiedByAdminIcon => IsVerifyByAdmin ? "oi oi-check" : "oi oi-x";

    private string IconClass => $"oi {Icon} oi-3x mb-3 icon-lg";

    private string GetIssueStatusIcon(IssueVisibilityEnum status)
    {
        return status switch
        {
            IssueVisibilityEnum.NotVisible => "oi oi-caret-left oi-3x mb-3 icon-lg",
            IssueVisibilityEnum.VisibleOnlyToMe => "oi oi-eye oi-3x mb-3 icon-lg",
            IssueVisibilityEnum.VisibleForAll => "oi oi-compass oi-3x mb-3 icon-lg",
            IssueVisibilityEnum.OutOfCurrentQuarter => "oi oi-bell oi-3x mb-3 icon-lg",
            IssueVisibilityEnum.OutOfCurrentQuarterVisibleOnlyToMe => "oi oi-yen oi-3x mb-3 icon-lg",
            _ => string.Empty,
        };
    }
}
