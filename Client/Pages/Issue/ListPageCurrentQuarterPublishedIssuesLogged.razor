@inherits ListPageBase<PublicPublishedIssueRead, PublicPublishedIssueSearchParamsDTO>
@attribute [Authorize]
@inject ISignatureService signatureService
@inject IIssueService issueService
@inject NavigationManager navigationManager
@page "/issue/published-issues-logged"

<_PagedListWrapper PagedListDto="PagedListDTO" result="apiResponse">
    <_ForEachPagedListWrapper PagedListDto="PagedListDTO" result="apiResponse">
        <_CustomPublishedIssueCard dto="@context" ShowButtons="true" ShowStatus="true">
            @if (!isActiveSubscription)
            {
                <button type="button" @onclick="@(() => navigationManager.NavigateTo("/subscription"))" class="btn btn-primary rounded-pill m-1" data-bs-toggle="tooltip">
                    Sign
                </button>
            }
            else if (!context.Id.IsNullOrEmpty())
            {
                if (context.SignedByCurrentUser)
                {
                    <button type="button" @onclick="@(async () => await UnsignIssue(context.Id))" class="btn btn-danger rounded-pill m-1" data-bs-toggle="tooltip">
                        Unsign
                    </button>
                }
                else
                {
                    <button type="button" @onclick="@(async () => await SignIssue(context.Id))" class="btn btn-primary rounded-pill m-1" data-bs-toggle="tooltip">
                        Sign
                    </button>
                }
            }
        </_CustomPublishedIssueCard>
    </_ForEachPagedListWrapper>
    <div class="row">
        <_Paging QueryBase="searchParamsDTO" RefreshList="Refresh" TotalPages="PagedListDTO.TotalPages" TotalItems="PagedListDTO.TotalItems" />
    </div>
</_PagedListWrapper>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthTask { get; set; }

    private bool isActiveSubscription = false;

    protected override async Task OnInitializedAsync()
    {
        var tuple = AuthHelper.IsActiveSubscription(await AuthTask);
        isActiveSubscription = tuple.Item1;
        await base.OnInitializedAsync();
    }

    protected override void InitializeSearchParams() => searchParamsDTO = new PublicPublishedIssueSearchParamsDTO();

    protected override async Task<ApiResponse<PagedListDto<PublicPublishedIssueRead>>> Get(PublicPublishedIssueSearchParamsDTO searchParamsDTO)
        => await issueService.GetCurrentQuarterIssues(searchParamsDTO);

    private async Task SignIssue(Guid issueId)
    {
        await signatureService.SignIssue(issueId);
        await Refresh();
    }

    private async Task UnsignIssue(Guid issueId)
    {
        await signatureService.UnsignIssue(issueId);
        await Refresh();
    }
}
