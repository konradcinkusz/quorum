@inherits ListPageBase<IssueSignedAndSubmittedDTO, IssueSignAndSubmitSearchParamsDTO>
@attribute [Authorize]
@inject IIssueService issueService
@page "/issue/your-winners"

<_PagedListWrapper PagedListDto="PagedListDTO" result="apiResponse">
    <_ForEachPagedListWrapper PagedListDto="PagedListDTO" result="apiResponse">
        <_CustomPublishedIssueCard dto="@context" ShowButtons="true" ShowStatus="true">
            @if (!context.Id.IsNullOrEmpty() && context.IssueSignedAndSubmittedProcess != IssueSignedAndSubmittedProcessEnum.Completed)
            {
                <a href="@context.PDF.SecureUri" download="@context.PDF.FileName" target="_blank">Download PDF: @context.PDF.FileName</a>
                @if (context.IssueSignedAndSubmittedProcess == IssueSignedAndSubmittedProcessEnum.NotDownloaded || context.IssueSignedAndSubmittedProcess == IssueSignedAndSubmittedProcessEnum.Downloaded)
                {
                    <input type="file" @onchange="@(async () => await OnFileChange(context.Id))" />
                }
                else if (context.IssueSignedAndSubmittedProcess == IssueSignedAndSubmittedProcessEnum.Uploaded)
                {
                    <button type="button" class="btn btn-danger rounded-pill m-1" @onclick="@(async () => await RemoveUploadedFile(context.Id))">Remove uploaded</button>
                }
            }
            else if (context.IssueSignedAndSubmittedProcess == IssueSignedAndSubmittedProcessEnum.Completed)
            {
                <span>Processing ended. Not possible to change something.</span>
            }
        </_CustomPublishedIssueCard>
    </_ForEachPagedListWrapper>
    <div class="row">
        <_Paging QueryBase="searchParamsDTO" RefreshList="Refresh" TotalPages="PagedListDTO.TotalPages" TotalItems="PagedListDTO.TotalItems" />
    </div>
</_PagedListWrapper>

@code {
    protected override void InitializeSearchParams() => searchParamsDTO = new IssueSignAndSubmitSearchParamsDTO();

    protected override async Task<ApiResponse<PagedListDto<IssueSignedAndSubmittedDTO>>> Get(IssueSignAndSubmitSearchParamsDTO searchParamsDTO)
        => await issueService.GetSignSubmitIssues(searchParamsDTO);

