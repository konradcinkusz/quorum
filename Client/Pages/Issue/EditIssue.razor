@attribute [Authorize]
@page "/issue/edit-issue/{id}"
@inject IIssueService issueService
@inject NavigationManager navigationManager

<PageTitle>Edit Issue</PageTitle>

@if (dto.InitialPaymnet != null)
{
    <div class="card shadow rounded-3 m-3">
        <ReadPayment Payment="dto.InitialPaymnet"></ReadPayment>
    </div>
}

<div class="card shadow rounded-3 m-3">
    <ReadIssue dto="issueReadDTO" />
</div>

<div class="card shadow rounded-3">
    <div class="card-header bg-primary text-white text-center py-3 rounded-3">
        <h5 class="card-title mb-0">Congratulation you have created issue! You can see and edit it below!</h5>
    </div>
    <div class="row justify-content-center">
        <div class="col-12 mt-5">
            <div class="row d-flex justify-content-center">
                <_CustomIssueCard BackgroundColor="@dto.BackgroundColor"
                                  Title="@dto.Title" Icon="@dto.Icon"
                                  Text="@dto.Question"
                                  ApplicationUserEmail="@issueReadDTO.ApplicationUserEmail"
                                  IsVerifyByAdmin="@issueReadDTO.IsVerifyByAdmin"
                                  IssueVisibility="@issueReadDTO.IssueVisibility"
                                  RatingValue="@issueReadDTO.RatingValue" />
            </div>
        </div>
    </div>

    <div class="card-body">
        <EditForm Model="@dto" OnValidSubmit="@Create" disabled="@(!canBeEdited)">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label for="title-value" class="form-label">Title</label>
                    <InputText id="title-value" class="form-control rounded-pill" @bind-Value="@dto.Title" @oninput="@((ChangeEventArgs e)=>{dto.Title = e?.Value?.ToString()??"";})" required />
                    <ValidationMessage For="@(() => dto.Title)" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="question-value" class="form-label">Question</label>
                    <InputTextArea id="question-value" class="form-control rounded-pill" @bind-Value="@dto.Question" @oninput="@((ChangeEventArgs e)=>{dto.Question = e?.Value?.ToString()??"";})" required />
                    <ValidationMessage For="@(() => dto.Question)" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="icon-value" class="form-label">Choose icon</label>
                    <_IconPicker Icon="@dto.Icon" IconChanged="HandleIconChanged" />
                </div>

                <div class="col-md-6 mb-4">
                    <label for="color-value" class="form-label">Choose color</label>
                    <_ColorPicker SelectedColor="@dto.BackgroundColor" SelectedColorChanged="@HandleColorChanged" />
                </div>
                <div class="row">
                    <div class="col-sm-12 col-md-4 d-grid">
                        <button type="submit" class="btn btn-primary rounded-pill">
                            Save Changes
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(id))
                    {
                        <div class="col-sm-12 col-md-4 d-grid">
                            <button type="button" @onclick="Publish" class="btn btn-primary rounded-pill inactive-subscription-button"
                                    disabled="@(!isActiveSubscription)" data-bs-toggle="tooltip" title="@(isActiveSubscription ? string.Empty : "You don't have an active subscription yet")">
                                Publish
                            </button>
                        </div>
                        @if (dto.InitialPaymnet == null)
                        {
                            <div class="col-sm-12 col-md-4 d-grid">
                                <button type="button" @onclick="Pay" class="btn btn-primary rounded-pill inactive-subscription-button"
                                        disabled="@(!isActiveSubscription)" data-bs-toggle="tooltip" title="@(isActiveSubscription ? string.Empty : "You don't have an active subscription yet")">
                                    Pay
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="col-sm-12 col-md-4 d-grid">
                                <button type="button" class="btn btn-primary rounded-pill disabled">
                                    Already paid
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (result != null)
{
    <_ApiResponse T="Guid" result="result" />
}

@if (published != null)
{
    <_ApiResponse T="bool" result="published" />
}

@if (paid != null)
{
    <_ApiResponse T="bool" result="paid" />
}

<style>
    .inactive-subscription-button {
        background-color: @(!isActiveSubscription ? "grey" : "#007bff");
    }
</style>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthTask { get; set; }

    [Parameter]
    public string id { get; set; }

    private bool isActiveSubscription = false;
    private string email;
    private bool canBeEdited = false;
    private IssueCreateDTO dto = new IssueCreateDTO();
    private IssueReadDTO issueReadDTO = new IssueReadDTO();
    private ApiResponse<Guid> result = null;
    private ApiResponse<bool> published = null;
    private IssuePayDTO issuePayDTO = null;
    private ApiResponse<bool> paid = null;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var authState = await AuthTask;
        var user = authState.User;
        var isActiveSubscriptionClaim = user.Claims.FirstOrDefault(x => x.Type == "isActiveSubscription");
        isActiveSubscription = bool.TryParse(isActiveSubscriptionClaim?.Value, out bool claimValue) ? claimValue : false;
        email = user.Claims.FirstOrDefault(x => x.Type == "name")?.Value ?? string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(id) && Guid.TryParse(id, out Guid result))
        {
            var issueResponse = await issueService.GetIssueByIdForEdit(result);
            issueReadDTO = issueResponse.Data;
            dto.Title = issueReadDTO.Title;
            dto.Question = issueReadDTO.Question;
            dto.Icon = issueReadDTO.Icon;
            dto.BackgroundColor = issueReadDTO.BackgroundColor;
            dto.InitialPaymnet = issueReadDTO.InitialPayment;
            canBeEdited = issueReadDTO.IssueProcess == IssueProcessEnum.InCreation || issueReadDTO.IssueProcess == IssueProcessEnum.Created;
        }
    }

    private void HandleIconChanged(string selectedIcon)
    {
        dto.Icon = selectedIcon;
    }

    private void HandleColorChanged(string selectedColor)
    {
        dto.BackgroundColor = selectedColor;
    }

    private async Task Create()
    {
        if (!string.IsNullOrEmpty(id) && Guid.TryParse(id, out Guid issueId))
        {
            result = await issueService.EditIssue(issueId, dto);

            if (result != null)
            {
                navigationManager.NavigateTo($"/issue/edit-issue/{result.Data}");
            }
        }
        else
        {
            result = new ApiResponse<Guid>() { Success = false, Message = "Problem with EditIssue page, Id doesn't match Guid!" };
        }
    }

    private async Task Publish()
    {
        if (!string.IsNullOrEmpty(id) && Guid.TryParse(id, out Guid issueId) && isActiveSubscription)
        {
            published = await issueService.PublishIssue(issueId);
        }
    }

    private async Task Pay()
    {
        if (!string.IsNullOrEmpty(id) && Guid.TryParse(id, out Guid issueId) && isActiveSubscription)
        {
            paid = await issueService.PayForAnIssue(issueId, issuePayDTO);
        }
    }
}
