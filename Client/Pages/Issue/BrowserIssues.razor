@inherits BaseAdmin

<div class="row domain-search bg-green rounded">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="row g-3 mt-2">
                    <div class="col-md-9 col-sm-12">
                        <input type="search" class="form-control rounded-pill" placeholder="User name" @bind-value="SearchParams.CreatedByEmail" @bind-value:event="oninput">
                    </div>
                    <div class="col-md-3 col-sm-12 text-end">
                        <button type="submit" class="btn btn-outline-light btn-block rounded-pill" @onclick="ClearQuery"><span class="flex-center search">Clear</span></button>
                        <button type="submit" class="btn btn-outline-light btn-block rounded-pill" @onclick="async () => await Refresh.InvokeAsync()"><span class="flex-center search">Search</span></button>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-12">
                        <label for="title" class="text-white">Issue ID</label>
                        <input type="text" id="title" class="form-control rounded-pill" @bind="SearchParams.IssueId" @bind:event="oninput">
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-3 col-sm-12">
                        <label for="title" class="text-white">Title</label>
                        <input type="text" id="title" class="form-control rounded-pill" @bind="SearchParams.Title" @bind:event="oninput">
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <label for="question" class="text-white">Question</label>
                        <input type="text" id="question" class="form-control rounded-pill" @bind="SearchParams.Question" @bind:event="oninput">
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <label for="isVerifyByAdmin" class="text-white">Verified by Admin</label>
                        <select id="isVerifyByAdmin" class="form-control rounded-pill" @bind="SearchParams.IsVerifyByAdmin" @bind:event="onchange">
                            <option value="">-- Select Verification --</option>
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <label for="issueStatus" class="text-white">Issue Status</label>
                        <select id="issueStatus" class="form-control rounded-pill" @bind="SearchParams.IssueStatus" @bind:event="onchange">
                            <option value="">-- Select Issue Status --</option>
                            @foreach (var status in Enum.GetValues(typeof(IssueStatusEnum)))
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-3 col-sm-12">
                        <label for="ratingValue" class="text-white">Rating Value</label>
                        <input type="number" id="ratingValue" class="form-control rounded-pill" @bind="SearchParams.RatingValue" @bind:event="oninput">
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <label for="hasInitialPayment" class="text-white">Has Initial Payment</label>
                        <select id="hasInitialPayment" class="form-control rounded-pill" @bind="SearchParams.HasInitialPayment" @bind:event="onchange">
                            <option value="">-- Select Payment --</option>
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <_Paging QueryBase="SearchParams"
                     RefreshList="async () => await Refresh.InvokeAsync()"
                     TotalPages="TotalPages"
                     TotalItems="TotalItems"></_Paging>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public IssueSearchParamsDTO SearchParams { get; set; }
    [Parameter]
    public EventCallback Refresh { get; set; }
    [Parameter]
    public int TotalPages { get; set; }
    [Parameter]
    public int TotalItems { get; set; } = 0;

    async Task ClearQuery()
    {
        SearchParams.CreatedByEmail = string.Empty;
        await Refresh.InvokeAsync();
    }
}
