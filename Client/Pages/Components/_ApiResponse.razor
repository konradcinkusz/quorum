@typeparam T

@if (result != null)
{
    <div class="alert @(result.Success ? "alert-success" : "alert-danger")" role="alert">
        <button type="button" class="close" @onclick="CloseApiResponse">
            <span aria-hidden="true">&times;</span>
        </button>
        @if (result.Success)
        {
            <span>@result.Data</span>
            <span>@result.Message</span>
        }
        else
        {
            @if (!string.IsNullOrEmpty(result.Message))
            {
                <span>@result.Message</span>
            }
            @if (result.Errors != null && result.Errors.Any())
            {
                <ul>
                    @foreach (var error in result.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
        }
        <span>Response Time: @result.ResponseTime</span>
    </div>
}

@code {
    [Parameter]
    public ApiResponse<T> result { get; set; }

    private void CloseApiResponse()
    {
        result = null;
    }
}
