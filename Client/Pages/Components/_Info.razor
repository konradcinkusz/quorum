<div class="info-container" style="background-color: @BackgroundColor">
    <div class="info-content">
        @Description
    </div>
</div>

<style>
    .info-container {
        margin: 10px;
        padding: 10px;
        border-radius: 5px;
        background-color: @BackgroundColor;
        transition: background-color 0.3s;
        box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.2);
    }

        .info-container:hover {
            background-color: rgba(0, 0, 0, 0.1);
        }

    .info-content {
        font-weight: bold;
        color: @TextColor;
        transition: opacity 0.3s;
    }

    .info-container:hover .info-content {
        opacity: 0.8;
    }

</style>
@code {
    [Parameter]
    public string BackgroundColor { get; set; } = "grey";

    [Parameter]
    public string TextColor { get; set; } = "white";

    [Parameter]
    public string Description { get; set; } = "You must be logged in as a super admin user at least to see this page.";
}
