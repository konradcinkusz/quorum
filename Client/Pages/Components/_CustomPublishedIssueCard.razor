<div class="@ColsDefinition">
    <div class="card border-0 shadow rounded-lg mb-4" style="background-color: @dto.BackgroundColor;">
        <div class="card-body text-center">
            <div class="card-header">
                <h5 class="card-title fw-bold fs-5">@dto.Title</h5>
            </div>
            <div class="mt-3">
                <span class="@IconClass"></span>
            </div>
            <p class="card-text mt-3">@dto.Question</p>
            <div class="card-footer text-muted mt-3">
                <div class="d-flex justify-content-between">
                    <span class="text-start black-text fs-6">@dto.ApplicationUserEmail</span>
                </div>
            </div>
            <div class="card-footer text-muted mt-3">
                <div class="d-flex justify-content-between">
                    <span class="text-end fw-bold black-text fs-6">@dto.RatingValue</span>
                </div>
            </div>
            <div class="card-footer text-muted">

                <div class="d-flex justify-content-center m-3">
                    @ChildContent
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string ColsDefinition { get; set; } = "col-sm-12 col-md-6 col-lg-4";

    [Parameter]
    public PublicPublishedIssueRead dto { get; set; } = new PublicPublishedIssueRead();

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool ShowButtons { get; set; } = false;

    [Parameter]
    public bool ShowStatus { get; set; } = false;

    private string IconClass => $"oi {dto.Icon} oi-3x mb-3 icon-lg";

    private string GetIssueStatusIcon(IssueVisibilityEnum status)
    {
        return status switch
        {
            IssueVisibilityEnum.NotVisible => "oi oi-caret-left oi-3x mb-3 icon-lg",
            IssueVisibilityEnum.VisibleOnlyToMe => "oi oi-eye oi-3x mb-3 icon-lg fw-bold text-danger",
            IssueVisibilityEnum.VisibleForAll => "oi oi-compass oi-3x mb-3 icon-lg",
            IssueVisibilityEnum.OutOfCurrentQuarter => "oi oi-bell oi-3x mb-3 icon-lg",
            IssueVisibilityEnum.OutOfCurrentQuarterVisibleOnlyToMe => "oi oi-yen oi-3x mb-3 icon-lg",
            _ => string.Empty,
        };
    }
}
