<div class="m-2 p-16 bg-surface-secondary">
    <div class="d-flex justify-content-between">
        <div class="p-2">
            <div>
                <button class="btn btn-light" type="button" @onclick="Previous">
                    <span class="oi oi-arrow-thick-left"></span>
                </button>
            </div>
        </div>
        <div class="p-2">
            <div>
                <p class="font-weight-bold mb-0">@TotalItems @(TotalItems == 1 ? "kwestia" : (TotalItems < 5 ? "kwestii" : "kwestiaów"))</p>
                <p class="mb-0">strona @QueryBase.CurrentPage z @TotalPages</p>
            </div>
        </div>
        <div class="p-2">
            <div>
                <button class="btn btn-dark" type="button" @onclick="Next">
                    <span class="oi oi-arrow-thick-right"></span>
                </button>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end mt-4">
        <span class="mr-2">Na stronie</span>
        <select class="form-select form-select-lg" @bind="selectedValue" @onclick="ChangePageSize">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
        </select>
    </div>
</div>

@code {
    [Parameter]
    public int TotalPages { get; set; }
    [Parameter]
    public int TotalItems { get; set; } = 0;
    [Parameter]
    public SearchParams QueryBase { get; set; }
    [Parameter]
    public EventCallback RefreshList { get; set; }

    int selectedValue = 10;

    async Task ChangePageSize()
    {
        QueryBase.PageSize = selectedValue;
        await RefreshList.InvokeAsync();
    }

    async Task Next()
    {
        try
        {
            if (QueryBase.CurrentPage < TotalPages)
            {
                QueryBase.CurrentPage++;
                await RefreshList.InvokeAsync();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
    }

    async Task Previous()
    {
        try
        {
            if (QueryBase.CurrentPage > 1)
            {
                QueryBase.CurrentPage--;
                await RefreshList.InvokeAsync();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
    }
}
