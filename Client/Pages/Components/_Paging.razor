<div class="d-flex align-items-center justify-content-center">
    <div class="d-flex align-items-center">
        <button class="btn btn-light me-3" type="button" @onclick="Previous" disabled="@IsPreviousButtonDisabled">
            <span class="oi oi-arrow-thick-left"></span>
        </button>
        <div class="d-flex align-items-center">
            <select class="form-select form-select-sm" @onchange="@((args) => ChangePageSize(args.Value.ToString()))">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
        <button class="btn btn-dark ms-3" type="button" @onclick="Next" disabled="@IsNextButtonDisabled">
            <span class="oi oi-arrow-thick-right"></span>
        </button>
    </div>
</div>
<p class="mb-0 text-center small">Page @QueryBase.CurrentPage/@TotalPages</p>

@code {
    [Parameter]
    public int TotalPages { get; set; }
    [Parameter]
    public int TotalItems { get; set; } = 0;
    [Parameter]
    public SearchParams QueryBase { get; set; }
    [Parameter]
    public EventCallback RefreshList { get; set; }

    private bool IsPreviousButtonDisabled => QueryBase.CurrentPage <= 1;
    private bool IsNextButtonDisabled => QueryBase.CurrentPage >= TotalPages;

    async Task ChangePageSize(string selectedValue)
    {
        int.TryParse(selectedValue, out int sv);
        QueryBase.PageSize = sv;
        await RefreshList.InvokeAsync();
    }

    async Task Next()
    {
        try
        {
            if (QueryBase.CurrentPage < TotalPages)
            {
                QueryBase.CurrentPage++;
                await RefreshList.InvokeAsync();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
    }

    async Task Previous()
    {
        try
        {
            if (QueryBase.CurrentPage > 1)
            {
                QueryBase.CurrentPage--;
                await RefreshList.InvokeAsync();
            }
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
    }
}
