@page "/reset-password"
@using Quorum.Client.Features.Auth
@using Quorum.Shared.DTOs.Auth
@inject IBffAuthClient Auth
@inject NavigationManager Navigation

<PageTitle>Reset password</PageTitle>

<div class="container" style="max-width: 28rem;">
    <h1 class="h3 my-4">Reset your password</h1>

    @if (_done)
    {
        <div class="alert alert-success" role="alert">Your password has been reset.</div>
        <a class="btn btn-primary" href="login">Log in</a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <InputText id="email" class="form-control" type="email" autocomplete="username" @bind-Value="_model.Email" />
                <ValidationMessage For="() => _model.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="token">Reset code</label>
                <InputText id="token" class="form-control" @bind-Value="_model.Token" />
                <div class="form-text">From the link in the reset email.</div>
                <ValidationMessage For="() => _model.Token" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">New password</label>
                <InputText id="password" class="form-control" type="password" autocomplete="new-password" @bind-Value="_model.NewPassword" />
                <ValidationMessage For="() => _model.NewPassword" />
            </div>
            <button class="btn btn-primary w-100" type="submit" disabled="@_busy">
                @(_busy ? "Resetting…" : "Reset password")
            </button>
        </EditForm>
    }
</div>

@code {
    private sealed class ResetModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Token { get; set; } = string.Empty;

        [Required, MinLength(8, ErrorMessage = "The password must be at least 8 characters long.")]
        public string NewPassword { get; set; } = string.Empty;
    }

    private readonly ResetModel _model = new();
    private string? _error;
    private bool _busy;
    private bool _done;

    [Parameter, SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override void OnParametersSet()
    {
        // Reset links arrive as /reset-password?email=…&token=…; typing both by hand is
        // the fallback, not the expectation.
        if (!string.IsNullOrEmpty(Email) && string.IsNullOrEmpty(_model.Email))
        {
            _model.Email = Email;
        }

        if (!string.IsNullOrEmpty(Token) && string.IsNullOrEmpty(_model.Token))
        {
            _model.Token = Token;
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await Auth.ResetPasswordAsync(
            new BffResetPasswordRequest(_model.Email, _model.Token, _model.NewPassword));
        if (result.Succeeded)
        {
            _done = true;
        }
        else
        {
            _error = result.ErrorMessage;
        }

        _busy = false;
    }
}
