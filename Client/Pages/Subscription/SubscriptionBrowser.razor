<div class="row domain-search bg-green rounded">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <h2 class="form-title">Search Subscriptions</h2>
            </div>
            <div class="col-md-9">
                <div class="row g-3">
                    <div class="col-md-9 col-sm-12">
                        <input type="search" class="form-control rounded-pill" placeholder="User name" @bind-value="phrase" @bind-value:event="oninput" required>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <button type="submit" class="btn btn-outline-light btn-block rounded-pill" @onclick="RefreshInternal"><span class="flex-center search">Search</span></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public SubscriptionSearchParamsDTO QuerySearch { get; set; }
    [Parameter]
    public EventCallback Refresh { get; set; }

    string phrase = string.Empty;


    async Task RefreshInternal()
    {
        QuerySearch.ApplicationUserId = phrase;

        await Refresh.InvokeAsync();
    }
}
