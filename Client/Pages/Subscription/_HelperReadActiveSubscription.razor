<div class="active-subscription-info row">
    @foreach (var i in Infos)
    {
        <div class="col-md-12">
            <_Info Description="@i" TextColor="#28a745" BackgroundColor="#eae8e8" />
        </div>
    }
</div>
@if (DTO.PaymentDate.HasValue && DTO.PaymentStatus.HasValue)
{
    <div class="payment-info row">
        <div class="col-md-12">
            <span>Your last payment status: </span>
        </div>
        <div class="payment-status col-md-12">@DTO.PaymentStatus </div>
        <div class="payment-date col-md-12">At: @DTO.PaymentDate</div>
    </div>
}

@if (DTO.Begin.HasValue && DTO.End.HasValue)
{
    <div class="subscription-period">
        <span>Subscription period:</span> @DTO.Begin.Value.ToShortDateString() - @DTO.End.Value.ToShortDateString()
    </div>
}

@code {
    [Parameter]
    public SubscriptionReadDTO DTO { get; set; }
    [Parameter]
    public List<string> Infos { get; set; }
}
