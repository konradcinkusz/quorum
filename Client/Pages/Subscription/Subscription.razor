@inherits Read
@page "/subscription"
@inject ISubscriptionService subscriptionService

<PageTitle>Sub & Payments</PageTitle>

<div class="subscription-container">
    <div class="subscription-info">
        @if (subscriptionReadDTO.IsActive || subscriptionReadDTO.PaymentStatus == PaymentStatusEnum.Accepted)
        {
            <div class="active-subscription-info">
                <span>You have an active subscription.</span>
            </div>
            @if (subscriptionReadDTO.Begin != null && subscriptionReadDTO.End != null)
            {
                <div class="subscription-period">
                    <span>Subscription period:</span> @subscriptionReadDTO.Begin.Value.ToShortDateString() - @subscriptionReadDTO.End.Value.ToShortDateString()
                </div>
            }
            <div class="payment-info">
                <span>Your last payment status:</span>
                <div class="payment-status">@subscriptionReadDTO.PaymentStatus</div>
                <div class="payment-date">@subscriptionReadDTO.PaymentDate</div>
            </div>
        }
        else if (subscriptionReadDTO.PaymentStatus == PaymentStatusEnum.Pending)
        {
            <div class="active-subscription-info">
                <span>You have bought subscription and we are waiting for your payment. </span>
                <span>Transfer any amount to the account: XXX XXX, providing your PESEL number in the title.</span>
            </div>
            <div class="payment-info">
                <span>Your last payment status: </span>
                <div class="payment-status">@subscriptionReadDTO.PaymentStatus </div>
                <div class="payment-date">@subscriptionReadDTO.PaymentDate</div>
            </div>
        }
        else
        {
            <div class="inactive-subscription-info">
                <span>You do not have an active subscription.</span>
                <button class="buy-subscription-button" @onclick="Buy">Buy subscription</button>
            </div>
        }
    </div>
    @if (!string.IsNullOrEmpty(appUserResult))
    {
        <div class="alert alert-success" role="alert">
            <span>@appUserResult</span>
        </div>
    }
</div>

@code {
    private SubscriptionReadDTO subscriptionReadDTO = new SubscriptionReadDTO();
    ApiResponse<SubscriptionReadDTO>? result = null;

    protected async override Task OnInitializedAsync()
    {
        result = await subscriptionService.GetSubscription();
        subscriptionReadDTO = result?.Data;
    }

    private string appUserResult { get; set; } = string.Empty;
    private async Task Buy()
    {
        appUserResult = await subscriptionService.BuySubscription();
    }
}