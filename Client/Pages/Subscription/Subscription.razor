@inherits Read
@page "/subscription"
@inject ISubscriptionService subscriptionService

<div class="subscription-container">
    <h2 class="subscription-header">Sub & payments</h2>

    <div class="subscription-info">
        <div class="price">
            <span>Price:</span> <span class="price-value">@subscriptionReadDTO.Price</span>
        </div>
        <div class="description">
            <span>Description:</span> You will buy a subscription for premium portal features.
        </div>

        @if (subscriptionReadDTO.Begin != null && subscriptionReadDTO.End != null)
        {
            <div class="subscription-period">
                <span>Subscription period:</span> @subscriptionReadDTO.Begin.Value.ToShortDateString() - @subscriptionReadDTO.End.Value.ToShortDateString()
            </div>
        }

        @if (subscriptionReadDTO.LastPayment != null && (subscriptionReadDTO.IsActive || subscriptionReadDTO.LastPayment.PaymentStatus == PaymentStatusEnum.Pending || subscriptionReadDTO.LastPayment.PaymentStatus == PaymentStatusEnum.Accepted))
        {
            <ReadPayment Payment="subscriptionReadDTO.LastPayment" />
        }
        else
        {
            <button class="buy-subscription-button" @onclick="Buy">Buy subscription</button>
        }
    </div>
    @if (!string.IsNullOrEmpty(appUserResult))
    {
        <div class="alert alert-success" role="alert">
            <span>@appUserResult</span>
        </div>
    }
</div>

@code {
    private SubscriptionReadDTO subscriptionReadDTO = new SubscriptionReadDTO();
    ApiResponse<SubscriptionReadDTO>? result = null;
    
    protected async override Task OnInitializedAsync()
    {
        result = await subscriptionService.GetSubscription();
        subscriptionReadDTO = result?.Data;
    }

    private string appUserResult { get; set; } = string.Empty;
    private async Task Buy()
    {
        appUserResult = await subscriptionService.Buy();
    }
}