@inherits Read
@attribute [Authorize]
@page "/subscription"
@inject ISubscriptionService subscriptionService

<PageTitle>Sub & Payments</PageTitle>

<div class="subscription-container">
    <div class="subscription-info">
        @if (result == null)
        {
            <div class="active-subscription-info row">
                <div class="col-md-12">
                    <_Info Description="Please wait, sub page is loading..." TextColor="#b58900" BackgroundColor="#eae8e8" />
                </div>
            </div>
        }
        else if (!result.Success)
        {
            <_ApiResponse result="result" />
        }
        else if (subscriptionReadDTO.SubscriptionViewStatusEnum == SubscriptionViewStatusEnum.SubBoughtAndWaitingForPayment)
        {
            <_HelperReadActiveSubscription DTO="@subscriptionReadDTO"
                                           Infos="@(new List<string> {"You have bought subscription and we are waiting for your payment.",
                    "Transfer any amount to the account: XXX XXX, providing your PESEL number in the title. After the transfer, you need to wait for up to 3 days for payment approval. Once the payment is approved, the annual subscription is automatically accepted."})" />

            <_HelperRejectUnsubscribe Action="Reject" />
        }
        else if (subscriptionReadDTO.SubscriptionViewStatusEnum == SubscriptionViewStatusEnum.SubBoughtButSomethingHappendWithAPayment)
        {
            <_HelperReadActiveSubscription DTO="@subscriptionReadDTO"
                                           Infos="@(new List<string> {"You have bought subscription but something went wrong with payment acceptation, contact administrator."})" />
        }
        else if (subscriptionReadDTO.SubscriptionViewStatusEnum == SubscriptionViewStatusEnum.YouHaveAnActiveSub)
        {
            <_HelperReadActiveSubscription DTO="@subscriptionReadDTO"
                                           Infos="@(new List<string> {"You have an active subscription. If you still see InActive in header, refresh your page."})" />
        }
        else if (subscriptionReadDTO.SubscriptionViewStatusEnum == SubscriptionViewStatusEnum.YourSubHasBeenActivatedByAdmin)
        {
            <_HelperReadActiveSubscription DTO="@subscriptionReadDTO"
                                           Infos="@(new List<string> {"Your subscription has been activated by admin so you don't have a payment record related."})" />
        }
        else if (subscriptionReadDTO.SubscriptionViewStatusEnum == SubscriptionViewStatusEnum.PaymentHasBeenAcceptedWaitingForAdminActivation)
        {
            <_HelperReadActiveSubscription DTO="@subscriptionReadDTO"
                                           Infos="@(new List<string> {"Payment has been accepted. Waiting for admin activation."})" />
        }
        else if (subscriptionReadDTO.SubscriptionViewStatusEnum == SubscriptionViewStatusEnum.YouDontHaveActiveSub || subscriptionReadDTO.SubscriptionViewStatusEnum == SubscriptionViewStatusEnum.NoPaymentYouHaveToBuySubscription)
        {
            @if (appUserResult == null)
            {
                <div class="inactive-subscription-info">
                    <span>You do not have an active subscription.</span>
                    <button class="buy-subscription-button" @onclick="Buy">Buy subscription</button>
                </div>
                <_CustomCard BackgroundColor="#6495ED" Title="Subscription" Icon="oi-book" Text="With an active subscription, you gain access to all active issues within a quarter, rather than being limited to just the top 10. Additionally, you have the ability to add your signature to an issue using the signature pull feature, and you can create your own issues." />

            }
            else
            {
                <div class="alert alert-success" role="alert">
                    <_ApiResponse result="appUserResult" />
                </div>
            }
        }
        else
        {
            <_Info BackgroundColor="red" TextColor="Something happend contact admin" />
        }
    </div>
</div>

@code {
    private SubscriptionReadDTO subscriptionReadDTO = new SubscriptionReadDTO();
    private ApiResponse<SubscriptionReadDTO>? result = null;

    protected async override Task OnInitializedAsync()
    {
        await _refresh();
    }

    private ApiResponse<bool>? appUserResult { get; set; } = null;
    private async Task Buy()
    {
        appUserResult = await subscriptionService.BuySubscription();
        await _refresh();
    }

    private async Task _refresh(int delay_miliseconds = 0)
    {
        if (delay_miliseconds > 0)
            await Task.Delay(delay_miliseconds); // Delay for delay seconds
        result = await subscriptionService.GetMySubscription();
        if (result != null && result.Data != null)
            subscriptionReadDTO = result.Data;
    }

    private async Task Reject()
    {
        appUserResult = await subscriptionService.RejectSubscription();
        await _refresh();
    }
}
