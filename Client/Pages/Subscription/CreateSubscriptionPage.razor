@inherits BaseAdmin
@page "/admin/create-subscription/{id?}"
@inject NavigationManager NavigationManager

<div class="card shadow rounded-3">
    <div class="card-header bg-primary text-white py-3 rounded-3">
        <h5 class="card-title mb-0">Create Subscription</h5>
    </div>

    <div class="card-body">
        <EditForm Model="@Subscription" OnValidSubmit="@CreateSubscription">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="row">
                <_FormField TValue="string" Id="Name" Label="Name" Value="@Subscription.ApplicationUserId" ValueChanged="@((string value) => Subscription.ApplicationUserId = value)" />
                <_FormField TValue="DateTime?" Id="Begin" Label="Begin" Value="@Subscription.Begin" ValueChanged="@((DateTime? value) => Subscription.Begin = value)" />
                <_FormField TValue="DateTime?" Id="End" Label="End" Value="@Subscription.End" ValueChanged="@((DateTime? value) => Subscription.End = value)" />
                <div class="col-md-12 d-grid">
                    <button type="submit" class="btn btn-primary rounded-pill">Create Subscription</button>
                </div>
            </div>
        </EditForm>
    </div>
    @if (!string.IsNullOrEmpty(id))
    {
        <div class="card-footer">
            <button class="btn btn-primary btn-sm" type="button" @onclick="GoBack">Go back</button>
        </div>
    }
</div>
@if (result != null)
{
    <div class="alert alert-success" role="alert">
        <_ApiResponse result="result" />
    </div>
}

@code {
    [Parameter]
    public string id { get; set; }

    private SubscriptionCreateForUserDTO Subscription = new SubscriptionCreateForUserDTO();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(id))
        {
            var subs = await adminService.GetSubscriptionsBySearchParams(new() { ApplicationUserId = id });
            var sub = subs.Data.Items.First();
            Subscription.End = sub.End;
            Subscription.Begin = sub.Begin;
            Subscription.ApplicationUserId = id;
        }
    }

    private ApiResponse<string>? result = null;
    private async Task CreateSubscription()
    {
        result = await adminService.CreateOrEditSubscription(Subscription);
    }

    private async Task GoBack()
    {
        // Retrieve the returnUrl query parameter
        var uri = new Uri(NavigationManager.Uri);
        var returnUrl = System.Web.HttpUtility.ParseQueryString(uri.Query).Get("returnUrl");

        // Redirect to the previous page
        NavigationManager.NavigateTo(returnUrl);
    }
}
