@attribute [Authorize(Policy = "AdminRoles")]
@page "/subscriptionsAdmin"
@inject ISubscriptionService subscriptionService

<PageTitle>Subscription admin Page</PageTitle>

<AuthorizeView>
    <Authorized>
        <CreateSubscriptionPage Refresh="_refresh"></CreateSubscriptionPage>
        <br />
        <hr />
        @if (SubscriptionPagedListDto == null)
        {
            <_Loading LoadingText="Ładowanie listy płatności" />
        }
        else
        {
            <SubscriptionBrowser Refresh="_refresh"
                        QuerySearch="SubscriptionQuerySearchDTO"></SubscriptionBrowser>
            @if (SubscriptionPagedListDto.Items.Count == 0)
            {
                <p><em>Brak subskrypcji spełniających kryteria wyszukiwania...</em></p>
            }
            else
            {
                <br />
                <br />
                <_Paging QueryBase="SubscriptionQuerySearchDTO"
                 RefreshList="_refresh"
                 TotalPages="SubscriptionPagedListDto.TotalPages"
                 TotalItems="SubscriptionPagedListDto.TotalItems"></_Paging>

                <div class="content">
                    <div class="container">
                        <div class="row align-content-center justify-content-center">
                            @foreach (var p in SubscriptionPagedListDto.Items)
                            {
                                <SubscriptionReadForList Subscription="p"></SubscriptionReadForList>
                            }
                        </div>
                    </div>
                </div>

                <_Paging QueryBase="SubscriptionQuerySearchDTO"
                 RefreshList="_refresh"
                 TotalPages="SubscriptionPagedListDto.TotalPages"
                 TotalItems="SubscriptionPagedListDto.TotalItems"></_Paging>
            }
        }
    </Authorized>
    <NotAuthorized>
        <div class="m-2 p-2 font-weight-bold" style="background-color:grey">
            You must be logged as a super admin user at least to see these page
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    SubscriptionSearchParamsDTO SubscriptionQuerySearchDTO;
    SubscriptionPagedListDTO? SubscriptionPagedListDto;

    protected override async Task OnInitializedAsync()
    {
        SubscriptionQuerySearchDTO = new SubscriptionSearchParamsDTO();
        await _refresh();
    }

    async Task _refresh()
    {
        SubscriptionPagedListDto = await subscriptionService.GetSubscriptions(SubscriptionQuerySearchDTO);
        SubscriptionQuerySearchDTO.CurrentPage = SubscriptionPagedListDto.CurrentPage;
        SubscriptionQuerySearchDTO.PageSize = SubscriptionPagedListDto.PageSize;
    }
}
