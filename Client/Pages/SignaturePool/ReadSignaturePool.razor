<div class="card m-1 p-1">
    <div class="row mb-3">
        <div class="col-sm-3">
            <p class="form-control-plaintext" id="Quarter-id">@UserSignaturePool.Year</p>
        </div>
        <div class="col-sm-3">
            <p class="form-control-plaintext" id="Quarter-id">@UserSignaturePool.QuarterNumber</p>
        </div>
        <div class="col-sm-3">
            <p class="form-control-plaintext" id="Quarter-createdat">@UserSignaturePool.CreatedAt</p>
        </div>
        <div class="col-sm-3">
            <div class="btn-group my-2" role="group">
                <button class="btn btn-primary btn-sm" type="button" @onclick="@(() => showDetails = !showDetails)">
                    @(showDetails ? "Show Details" : "Hide Details")
                </button>
            </div>
        </div>
    </div>

    <div class="@(showDetails ? "d-block" : "d-none")">
        <hr />
        <h5>Details</h5>
        <dl class="row mb-3">
            <dt class="col-sm-3">Id</dt>
            <dd class="col-sm-9">@UserSignaturePool.Id</dd>

            <dt class="col-sm-3">Signatures count</dt>
            <dd class="col-sm-9">@UserSignaturePool.SignatureDTOs.Count</dd>

            <dt class="col-sm-3">Signed</dt>
            <dd class="col-sm-9 separator-line">@UserSignaturePool.SignatureDTOs.Where(x=>x.IssueDTO != null).Count()</dd>

            @foreach (var signature in UserSignaturePool.SignatureDTOs)
            {
                <dt class="col-sm-3">Signed issue</dt>
                <dd class="col-sm-9">@(signature.IssueDTO != null ? $"Signed: {signature.IssueDTO.Id}" : "null")</dd>
                
                @if (signature.IssueDTO != null && !signature.IssueDTO.Id.IsNullOrEmpty())
                {
                    <dt class="col-sm-3">Actions:</dt>
                    <dd class="col-sm-9 separator-line">
                        <div class="row">
                            <button type="button" @onclick="@(async () => await UnsignIssue.InvokeAsync(signature.IssueDTO.Id))" class="btn btn-danger rounded-pill m-1" data-bs-toggle="tooltip">
                                Unsign
                            </button>
                        </div>
                    </dd>
                }
            }
        </dl>
    </div>
</div>

@code {
    [Parameter]
    public UserSignaturePool UserSignaturePool { get; set; }

    [Parameter]
    public EventCallback<Guid> UnsignIssue { get; set; }

    private bool showDetails = false;
}
