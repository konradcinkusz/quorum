<div class="card">
    <div class="row mb-3">
        <div class="col-sm-2">
            <button class="btn btn-link" @onclick="@(() => SortData("Year"))">
                Year
                @if (SearchParams.SortColumn == "Year")
                {
                    <i class="@GetSortIconClass(SearchParams.SortOrder)"></i>
                }
            </button>
        </div>

        <div class="col-sm-2">
            <button class="btn btn-link" @onclick="@(() => SortData("Month"))">
                Month
                @if (SearchParams.SortColumn == "Month")
                {
                    <i class="@GetSortIconClass(SearchParams.SortOrder)"></i>
                }
            </button>
        </div>

        <div class="col-sm-2">
            <button class="btn btn-link" @onclick="@(() => SortData("ApplicationUserEmail"))">
                ApplicationUserEmail
                @if (SearchParams.SortColumn == "ApplicationUserEmail")
                {
                    <i class="@GetSortIconClass(SearchParams.SortOrder)"></i>
                }
            </button>
        </div>

        <div class="col-sm-3">
            <button class="btn btn-link" @onclick="@(() => SortData("CreatedAt"))">
                CreatedAt
                @if (SearchParams.SortColumn == "CreatedAt")
                {
                    <i class="@GetSortIconClass(SearchParams.SortOrder)"></i>
                }
            </button>
        </div>

        <div class="col-sm-3">
            Actions:
        </div>
    </div>
</div>

@code {
    [Parameter]
    public SignaturePoolsSearchParamsDTO SearchParams { get; set; }

    [Parameter]
    public EventCallback Refresh { get; set; }

    private async Task SortData(string column)
    {
        if (SearchParams.SortColumn == column)
        {
            SearchParams.SortOrder = SearchParams.SortOrder == SortOrder.Ascending ? SortOrder.Descending : SortOrder.Ascending;
        }
        else
        {
            SearchParams.SortColumn = column;
            SearchParams.SortOrder = SortOrder.Ascending;
        }

        // implement sorting logic based on the selected column and sort order
        await Refresh.InvokeAsync();
    }

    private string GetSortIconClass(SortOrder order)
    {
        return order == SortOrder.Ascending ? "bi bi-caret-up" : "bi bi-caret-down";
    }
}
