@inherits Header

<div class="card">
    <div class="row mb-3">
        <div class="col-sm-2">
            <button class="btn btn-link" @onclick="@(() => SortData("Id"))">
                Quarter ID
                @if (SearchParams.SortColumn == "Id")
                {
                    <i class="@GetSortIconClass(SearchParams.SortOrder)"></i>
                }
            </button>
        </div>

        <div class="col-sm-3">
            <button class="btn btn-link" @onclick="@(() => SortData("Month"))">
                Month
                @if (SearchParams.SortColumn == "Month")
                {
                    <i class="@GetSortIconClass(SearchParams.SortOrder)"></i>
                }
            </button>
        </div>

        <div class="col-sm-2">
            <button class="btn btn-link" @onclick="@(() => SortData("Year"))">
                Year
                @if (SearchParams.SortColumn == "Year")
                {
                    <i class="@GetSortIconClass(SearchParams.SortOrder)"></i>
                }
            </button>
        </div>

        <div class="col-sm-2">
            <button class="btn btn-link" @onclick="@(() => SortData("CreatedAt"))">
                CreatedAt
                @if (SearchParams.SortColumn == "CreatedAt")
                {
                    <i class="@GetSortIconClass(SearchParams.SortOrder)"></i>
                }
            </button>
        </div>

        <div class="col-sm-3">
            Actions:
        </div>
    </div>
</div>
