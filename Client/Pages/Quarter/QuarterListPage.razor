@inherits BaseAdmin
@page "/admin/quarters"
@inject IAdminService adminService

<PageTitle>Quarters list</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (QuarterPagedListDto == null)
        {
            <_Loading LoadingText="Ładowanie listy płatności" />
        }
        else
        {
            <QuarterBrowser Refresh="_refresh"
                        QuerySearch="QuarterSearchParamsDTO"></QuarterBrowser>
            @if (result != null)
            {
                <_ApiResponse T="QuarterPagedListDTO" result="result" />
            }
            @if (QuarterPagedListDto.Items.Count == 0)
            {
                <p><em>Brak kwestii spełniających kryteria wyszukiwania...</em></p>
            }
            else
            {
                <br />
                <br />
                <_Paging QueryBase="QuarterSearchParamsDTO"
                 RefreshList="_refresh"
                 TotalPages="QuarterPagedListDto.TotalPages"
                 TotalItems="QuarterPagedListDto.TotalItems"></_Paging>
                <HeaderQuarter Refresh="_refresh"
                       SearchParams="QuarterSearchParamsDTO"></HeaderQuarter>
                <div class="content">
                    <div class="container">
                        <div class="row align-content-center justify-content-center">
                            @foreach (var p in QuarterPagedListDto.Items)
                            {
                                <ReadQuarter Quarter="p"></ReadQuarter>
                            }
                        </div>
                    </div>
                </div>

                <_Paging QueryBase="QuarterSearchParamsDTO"
                 RefreshList="_refresh"
                 TotalPages="QuarterPagedListDto.TotalPages"
                 TotalItems="QuarterPagedListDto.TotalItems"></_Paging>
            }
        }
    </Authorized>
    <NotAuthorized>
        <div class="m-2 p-2 font-weight-bold" style="background-color:grey">
            You must be logged as a super admin user at least to see these page
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    QuarterSearchParamsDTO QuarterSearchParamsDTO;
    QuarterPagedListDTO? QuarterPagedListDto;

    private ApiResponse<QuarterPagedListDTO> result = null;

    protected override async Task OnInitializedAsync()
    {
        QuarterSearchParamsDTO = new QuarterSearchParamsDTO();
        await _refresh();
    }

    async Task _refresh()
    {
        result = await adminService.GetQuarters(QuarterSearchParamsDTO);
        QuarterPagedListDto = result.Data;
        QuarterSearchParamsDTO.CurrentPage = QuarterPagedListDto.CurrentPage;
        QuarterSearchParamsDTO.PageSize = QuarterPagedListDto.PageSize;
    }
}
