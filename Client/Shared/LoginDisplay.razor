@using Quorum.Client.Features.Auth
@inject NavigationManager Navigation
@inject IBffAuthClient Auth
@inject BffAuthenticationStateProvider AuthState

<AuthorizeView>
    <Authorized>
        <div class="subscription-status@(IsActiveSubscription ? " active" : " inactive")">
            @if (IsActiveSubscription)
            {
                <span>Active</span>
            }
            else
            {
                <span>Inactive</span>
            }
        </div>

        <span class="nav-link d-inline">Hello, @context.User.Identity?.Name!</span>
        <button class="nav-link btn btn-link" @onclick="BeginLogOut">Log out</button>
    </Authorized>
    <NotAuthorized>
        <a href="register">Register</a>
        <a href="login">Log in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthTask { get; set; }

    private bool IsActiveSubscription = false;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        var tuple = AuthHelper.IsActiveSubscription(await AuthTask);
        IsActiveSubscription = tuple.Item1;
    }

    private async Task BeginLogOut()
    {
        // The BFF revokes the upstream session and deletes the HttpOnly cookies; the
        // provider then flips the UI to anonymous.
        await Auth.LogoutAsync();
        await AuthState.ReloadSessionAsync();
        Navigation.NavigateTo("/");
    }
}
