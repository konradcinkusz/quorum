@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        // Send the user back where they were headed once they sign in. Relative on purpose:
        // the login page refuses absolute return targets.
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(string.IsNullOrEmpty(relative)
            ? "login"
            : $"login?returnUrl={Uri.EscapeDataString("/" + relative)}");
    }
}
