<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Holds the PostgreSQL migration set, and nothing else.

    One migration set cannot serve both providers: the generated DDL differs. Keeping each
    provider's set in its own assembly is the standard answer, and is what the provider
    switch in AddDbContextService selects between at runtime (P4).

    This references Quorum.Persistence rather than the Server, so that the Server can
    reference it back without a cycle — which is what `dotnet ef` requires to load a
    migrations assembly at all. The EF Core provider packages arrive transitively from
    Quorum.Persistence; nothing is referenced here that is not already referenced there.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Quorum.Persistence.Migrations.PostgreSQL</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quorum.Persistence\Quorum.Persistence.csproj" />
  </ItemGroup>

</Project>
